@model Ecommerce_1035.Models.Models.ViewModel.ShoppingCartVM

@section Head {
    <style>
        /* ============================================================
                   CART PAGE
                ============================================================ */
        .cart-page {
            --brand-1: #6c2bd9;
            --brand-2: #8b3dff;
            --brand-soft: #f3f0fb;
            --ink: #14110d;
            --ink-soft: #5c5449;
            --paper: #f7f4ee;
            --rule: #cfc4ac;
            --rule-dark: #9c8a68;
            --gold: #8a6c34;
            --accent: #6b2a2a;
            --ok: #15803d;
            --serif: 'Cormorant Garamond', Georgia, serif;
            --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

            .cart-page .cart-container {
                max-width: 1160px;
                margin: 36px auto 60px;
                padding: 0 24px;
            }

            .cart-page .cart-card {
                background: #fff;
                border-radius: 14px;
                overflow: hidden;
                box-shadow: 0 1px 3px rgba(20,10,50,.06), 0 18px 44px -28px rgba(20,10,50,.28);
            }

            /* ---------- Card header ---------- */
            .cart-page .cart-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                padding: 20px 26px;
                background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
                color: #fff;
                flex-wrap: wrap;
            }

                .cart-page .cart-header .title {
                    display: inline-flex;
                    align-items: center;
                    gap: 10px;
                    font-family: var(--serif);
                    font-size: 1.35rem;
                    font-weight: 600;
                    font-style: italic;
                    margin: 0;
                    line-height: 1.2;
                }

                    .cart-page .cart-header .title i {
                        font-size: 1.05rem;
                    }

            .cart-page .btn-continue {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 9px 16px;
                background: rgba(255,255,255,.14);
                border: 1px solid rgba(255,255,255,.32);
                border-radius: 9px;
                color: #fff;
                font-family: var(--sans);
                font-size: 13px;
                font-weight: 500;
                text-decoration: none;
                transition: background .15s, border-color .15s;
            }

                .cart-page .btn-continue:hover {
                    background: rgba(255,255,255,.24);
                    border-color: rgba(255,255,255,.5);
                    color: #fff;
                }

                .cart-page .btn-continue i {
                    font-size: 11px;
                }

            /* ---------- Table ---------- */
            .cart-page .cart-table-wrap {
                overflow-x: auto;
            }

            .cart-page .cart-table {
                width: 100%;
                border-collapse: collapse;
                margin: 0;
                font-family: var(--sans);
            }

                .cart-page .cart-table thead th {
                    background: var(--paper);
                    border-bottom: 1px solid var(--rule);
                    padding: 14px 16px;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: .14em;
                    text-transform: uppercase;
                    color: var(--ink-soft);
                    text-align: left;
                    vertical-align: middle;
                }

                    .cart-page .cart-table thead th.pl-4 {
                        padding-left: 26px;
                    }

                .cart-page .cart-table tbody td {
                    padding: 20px 16px;
                    border-bottom: 1px solid #f0ece3;
                    vertical-align: middle;
                    color: var(--ink);
                    font-size: 14px;
                }

                .cart-page .cart-table tbody tr:last-child td {
                    border-bottom: none;
                }

                .cart-page .cart-table tbody tr:hover td {
                    background: #fbfaf6;
                }

                .cart-page .cart-table tbody td.pl-4 {
                    padding-left: 26px;
                }

            /* ---------- Select all cell ---------- */
            .cart-page .select-all-wrap {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
                margin: 0;
            }

                .cart-page .select-all-wrap span {
                    font-size: 13px;
                    font-weight: 600;
                    color: var(--ink);
                }

            .cart-page .form-check-input {
                appearance: none;
                -webkit-appearance: none;
                width: 18px;
                height: 18px;
                border: 1.5px solid var(--rule-dark);
                border-radius: 4px;
                background: #fff;
                cursor: pointer;
                position: relative;
                transition: all .15s;
                flex-shrink: 0;
                margin: 0;
            }

                .cart-page .form-check-input:hover {
                    border-color: var(--brand-1);
                }

                .cart-page .form-check-input:checked {
                    background: var(--brand-1);
                    border-color: var(--brand-1);
                }

                    .cart-page .form-check-input:checked::after {
                        content: '';
                        position: absolute;
                        left: 5px;
                        top: 1px;
                        width: 5px;
                        height: 10px;
                        border: solid #fff;
                        border-width: 0 2px 2px 0;
                        transform: rotate(45deg);
                    }

                .cart-page .form-check-input:focus-visible {
                    outline: none;
                    box-shadow: 0 0 0 3px rgba(108,43,217,.2);
                }

            /* ---------- Item cell ---------- */
            .cart-page .item-cell {
                display: inline-flex;
                align-items: center;
                gap: 14px;
            }

                .cart-page .item-cell img {
                    width: 72px;
                    height: 96px;
                    object-fit: cover;
                    border-radius: 6px;
                    box-shadow: 0 4px 12px -6px rgba(20,17,13,.35);
                    background: var(--paper);
                }

            .cart-page .item-title {
                font-family: var(--serif);
                font-size: 1.15rem;
                font-weight: 700;
                color: var(--ink);
                margin: 0;
                line-height: 1.25;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .cart-page .item-desc {
                font-family: var(--sans);
                font-size: 12.5px;
                color: var(--ink-soft);
                line-height: 1.5;
                margin: 0;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .cart-page .price-cell {
                font-family: var(--serif);
                font-size: 1.05rem;
                font-weight: 600;
                color: var(--ink);
                font-variant-numeric: tabular-nums;
                white-space: nowrap;
            }

            .cart-page .total-cell {
                font-family: var(--serif);
                font-size: 1.2rem;
                font-weight: 700;
                color: var(--accent);
                font-variant-numeric: tabular-nums;
                white-space: nowrap;
            }

            /* ---------- Quantity stepper ---------- */
            .cart-page .qty-stepper {
                display: inline-flex;
                align-items: center;
                border: 1px solid var(--rule-dark);
                border-radius: 8px;
                overflow: hidden;
                background: #fff;
                height: 36px;
            }

                .cart-page .qty-stepper a {
                    width: 32px;
                    height: 36px;
                    display: grid;
                    place-items: center;
                    color: var(--ink);
                    text-decoration: none;
                    font-size: 12px;
                    transition: background .15s, color .15s;
                    border: none !important;
                    border-radius: 0 !important;
                    padding: 0 !important;
                }

                    .cart-page .qty-stepper a:hover {
                        background: var(--brand-soft);
                        color: var(--brand-1);
                    }

                .cart-page .qty-stepper .val {
                    min-width: 40px;
                    height: 36px;
                    display: grid;
                    place-items: center;
                    border-left: 1px solid var(--rule);
                    border-right: 1px solid var(--rule);
                    font-family: var(--sans);
                    font-size: 14px;
                    font-weight: 600;
                    color: var(--ink);
                    font-variant-numeric: tabular-nums;
                }

            /* ---------- Remove button ---------- */
            .cart-page .btn-remove {
                width: 34px;
                height: 34px;
                display: inline-grid;
                place-items: center;
                border-radius: 8px;
                color: var(--ink-soft);
                text-decoration: none;
                transition: all .15s;
                font-size: 14px;
                border: none !important;
                background: transparent !important;
                padding: 0 !important;
            }

                .cart-page .btn-remove:hover {
                    background: #fee2e2 !important;
                    color: #dc2626;
                }

            /* ---------- Footer ---------- */
            .cart-page .cart-footer {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
                padding: 22px 26px;
                background: var(--paper);
                border-top: 1px solid var(--rule);
                flex-wrap: wrap;
            }

                .cart-page .cart-footer .note {
                    font-family: var(--sans);
                    font-size: 12.5px;
                    color: var(--ink-soft);
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                }

                    .cart-page .cart-footer .note i {
                        color: var(--brand-1);
                        font-size: 13px;
                    }

            .cart-page .footer-actions {
                display: flex;
                align-items: center;
                gap: 22px;
                flex-wrap: wrap;
            }

            .cart-page .total-block {
                display: flex;
                align-items: baseline;
                gap: 12px;
            }

                .cart-page .total-block .label {
                    font-family: var(--sans);
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: .16em;
                    text-transform: uppercase;
                    color: var(--ink-soft);
                }

                .cart-page .total-block .amount {
                    font-family: var(--serif);
                    font-size: 2rem;
                    font-weight: 700;
                    color: var(--accent);
                    line-height: 1;
                    font-variant-numeric: tabular-nums;
                }

            .cart-page .btn-summary {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                padding: 15px 30px;
                background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
                color: #fff;
                border: none;
                border-radius: 10px;
                font-family: var(--sans);
                font-size: 15px;
                font-weight: 600;
                cursor: pointer;
                transition: transform .15s, box-shadow .15s;
                box-shadow: 0 10px 26px -10px rgba(108,43,217,.6);
            }

                .cart-page .btn-summary:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 14px 32px -10px rgba(108,43,217,.75);
                }

                .cart-page .btn-summary:active {
                    transform: translateY(0);
                }

                .cart-page .btn-summary i {
                    font-size: 14px;
                }

        @@media (max-width: 900px) {
            .cart-page .cart-footer {
                flex-direction: column;
                align-items: stretch;
            }

            .cart-page .footer-actions {
                justify-content: space-between;
            }
        }

        @@media (max-width: 520px) {
            .cart-page .cart-container {
                padding: 0 16px;
                margin: 20px auto 40px;
            }

            .cart-page .cart-header {
                padding: 16px 20px;
            }

            .cart-page .cart-table tbody td {
                padding: 16px 12px;
            }

            .cart-page .cart-table thead th {
                padding: 12px;
            }

            .cart-page .item-cell img {
                width: 56px;
                height: 76px;
            }

            .cart-page .item-desc {
                display: none;
            }

            .cart-page .cart-footer {
                padding: 18px 16px;
            }

            .cart-page .total-block .amount {
                font-size: 1.65rem;
            }

            .cart-page .btn-summary {
                width: 100%;
            }

            .cart-page .footer-actions {
                flex-direction: column;
                gap: 14px;
            }

            .cart-page .total-block {
                justify-content: center;
            }
        }
    </style>
}

<div class="cart-page">
    <form method="get" asp-area="Customer" asp-controller="Cart" asp-action="summary">
        <div class="cart-container">
            <div class="cart-card">

                <!-- Header -->
                <div class="cart-header">
                    <div class="title">
                        <i class="fa fa-shopping-cart"></i>
                        Shopping Cart
                    </div>
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn-continue">
                        <i class="fa-solid fa-arrow-left"></i>
                        Continue Shopping
                    </a>
                </div>

                <!-- Table -->
                <div class="cart-table-wrap">
                    <table class="cart-table">
                        <thead>
                            <tr>
                                <th class="pl-4">
                                    <label class="select-all-wrap">
                                        <input type="checkbox" id="selectAll" class="form-check-input" checked />
                                        <span>Select All</span>
                                    </label>
                                </th>
                                <th></th>
                                <th></th>
                                <th style="text-align:center;">Price</th>
                                <th style="text-align:center;">Quantity</th>
                                <th style="text-align:right;">Total</th>
                                <th style="text-align:center;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ListCart != null && Model.ListCart.Any())
                            {
                                foreach (var list in Model.ListCart)
                                {
                                    <tr>
                                        <td class="pl-4">
                                            <div class="item-cell">
                                                <input type="checkbox"
                                                       name="selectedItem"
                                                       value="@list.Id"
                                                       class="form-check-input item-select"
                                                       checked
                                                       data-price="@(list.Price * list.Count)" />
                                                <img src="@list.Product.ImageUrl"
                                                     alt="Cover of @list.Product.Title"
                                                     onerror="this.onerror=null;this.src='/images/placeholder-book.png';" />
                                            </div>
                                        </td>

                                        <td>
                                            <div class="item-title">@list.Product.Title</div>
                                        </td>

                                        <td>
                                            <div class="item-desc">
                                                @Html.Raw(list.Product.Description)
                                            </div>
                                        </td>

                                        <td class="price-cell" style="text-align:center;">
                                            ₹@list.Price.ToString("N2")
                                        </td>

                                        <td style="text-align:center;">
                                            <div class="qty-stepper">
                                                <a asp-action="minus" asp-route-id="@list.Id" aria-label="Decrease quantity">
                                                    <i class="fa-solid fa-minus"></i>
                                                </a>
                                                <span class="val">@list.Count</span>
                                                <a asp-action="plus" asp-route-id="@list.Id" aria-label="Increase quantity">
                                                    <i class="fa-solid fa-plus"></i>
                                                </a>
                                            </div>
                                        </td>

                                        <td class="total-cell" style="text-align:right;">
                                            ₹@((list.Price * list.Count).ToString("N2"))
                                        </td>

                                        <td style="text-align:center;">
                                            <a asp-action="delete" asp-route-id="@list.Id"
                                               class="btn-remove"
                                               aria-label="Remove @list.Product.Title from cart">
                                                <i class="fa-solid fa-trash-alt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        Your shopping cart is currently empty.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Footer -->
                <div class="cart-footer">
                    <div class="note">
                        <i class="fa-solid fa-circle-info"></i>
                        Taxes and shipping calculated at checkout.
                    </div>

                    <div class="footer-actions">
                        <div class="total-block">
                            <span class="label">Total</span>
                            <span class="amount">
                                ₹<span id="txtOrderTotal">@Model.OrderHeader.OrderTotal.ToString("N2")</span>
                            </span>
                        </div>

                        <button type="submit" id="btnSummary" class="btn-summary">
                            Summary
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        toastr.options = {
            "closeButton": true,
            "positionClass": "toast-bottom-center",
            "timeOut": "2000"
        };

        const selectAllBox = document.getElementById("selectAll");
        const itemBoxes = document.querySelectorAll(".item-select");
        const totalText = document.getElementById("txtOrderTotal");
        const submitBtn = document.getElementById("btnSummary");

        function updateCart() {
            let totalMoney = 0;
            let checkedBoxes = 0;

            itemBoxes.forEach(box => {
                if (box.checked) {
                    totalMoney += parseFloat(box.getAttribute("data-price"));
                    checkedBoxes++;
                }
            });

            totalText.innerText = totalMoney.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            if (selectAllBox) {
                selectAllBox.checked = (checkedBoxes === itemBoxes.length && itemBoxes.length > 0);
            }
        }

        if (selectAllBox) {
            selectAllBox.addEventListener("change", function () {
                itemBoxes.forEach(box => {
                    box.checked = selectAllBox.checked;
                });
                updateCart();
            });
        }

        itemBoxes.forEach(box => {
            box.addEventListener("change", updateCart);
        });

        submitBtn.addEventListener("click", function (e) {
            const selectedCount = document.querySelectorAll(".item-select:checked").length;
            if (selectedCount === 0) {
                e.preventDefault();
                toastr.warning('Please select at least 1 item to proceed.', 'No items selected');
            }
        });

        updateCart();
    </script>
}