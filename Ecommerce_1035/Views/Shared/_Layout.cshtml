@using Ecommerce_1035.Utilities

@inject IHttpContextAccessor httpContextAccessor

@{
    var cartCount = httpContextAccessor.HttpContext?.Session.GetInt32(SD.Ss_CartSessionCount) ?? 0;
    var isAdmin = User.IsInRole(SD.Role_Admin);
    var isEmployee = User.IsInRole(SD.Role_Employee);
    var isStaff = isAdmin || isEmployee;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var currentController = (string?)ViewContext.RouteData.Values["controller"];
    var currentAction = (string?)ViewContext.RouteData.Values["action"];
    var currentArea = (string?)ViewContext.RouteData.Values["area"];

    string Active(string? controller, string? action = null, string? area = null)
    {
        var c = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        var a = action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        var ar = area == null || string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase);
        return c && a && ar ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#6c2bd9" />
    <meta name="description" content="@(ViewData["Description"] ?? "Book Store — fine books, carefully chosen.")" />

    <title>@ViewData["Title"] · Book Store</title>

    <link rel="preconnect" href="https://cdn.datatables.net" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.16/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/1.1.3/sweetalert.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ecommerce_1035.styles.css" asp-append-version="true" />

    <style>
        :root {
            --brand-1: #6c2bd9;
            --brand-2: #8b3dff;
            --brand-3: #4c1d95;
            --brand-soft: #f3f0fb;
            --ink: #14110d;
            --ink-soft: #5c5449;
            --paper: #f7f4ee;
            --paper-2: #ece4d3;
            --paper-3: #d9cdb2;
            --rule: #cfc4ac;
            --rule-dark: #9c8a68;
            --gold: #8a6c34;
            --gold-bright: #fde68a;
            --accent: #6b2a2a;
            --header-h: 64px;
        }

        html { scroll-behavior: smooth; }

        html, body {
            background: var(--paper);
            color: var(--ink);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            font-size: 15px;
            line-height: 1.55;
            min-height: 100%;
            margin: 0;
        }

        /* ================= Skip link ================= */
        .skip-link {
            position: absolute;
            top: -100px;
            left: 12px;
            z-index: 2000;
            background: var(--ink);
            color: #fff;
            padding: 10px 16px;
            border-radius: 4px;
            font-size: 14px;
            text-decoration: none;
            transition: top .2s ease;
        }
        .skip-link:focus {
            top: 12px;
            color: #fff;
            outline: 2px solid var(--gold-bright);
        }

        :focus-visible {
            outline: 2px solid var(--brand-2);
            outline-offset: 2px;
        }

        /* ================= HEADER ================= */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 1030;
            background: linear-gradient(135deg, var(--brand-3) 0%, var(--brand-1) 45%, var(--brand-2) 100%);
            box-shadow: 0 2px 12px rgba(20, 10, 50, .18);
        }

        .site-nav {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 22px;
            min-height: var(--header-h);
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        /* ---------- Brand ---------- */
        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: .02em;
            color: #fff;
            text-decoration: none;
            padding: 12px 0;
            flex-shrink: 0;
        }
        .brand em { font-style: italic; font-weight: 400; color: var(--gold-bright); }
        .brand .mark {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: rgba(255,255,255,.15);
            border: 1px solid rgba(255,255,255,.28);
            display: grid;
            place-items: center;
            font-size: 16px;
            color: var(--gold-bright);
        }
        .brand:hover { color: #fff; }

        /* ---------- Menu toggle ---------- */
        .nav-toggle {
            display: none;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            background: transparent;
            border: 1px solid rgba(255,255,255,.35);
            color: #fff;
            border-radius: 6px;
            font-size: 15px;
            cursor: pointer;
            transition: background .15s ease;
        }
        .nav-toggle:hover { background: rgba(255,255,255,.12); }
        .nav-toggle:focus-visible { outline: 2px solid var(--gold-bright); outline-offset: 2px; }

        /* ---------- Nav list ---------- */
        .nav-menu {
            display: flex;
            align-items: center;
            gap: 4px;
            list-style: none;
            margin: 0;
            padding: 0;
            flex: 1;
        }
        .nav-menu > li { position: relative; }

        .nav-menu a,
        .nav-menu button.nav-trigger {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 6px;
            font-family: inherit;
            font-size: 14px;
            font-weight: 500;
            color: rgba(255,255,255,.92);
            text-decoration: none;
            background: transparent;
            border: none;
            cursor: pointer;
            white-space: nowrap;
            transition: background .15s ease, color .15s ease;
        }
        .nav-menu a:hover,
        .nav-menu button.nav-trigger:hover,
        .nav-menu a.active {
            background: rgba(255,255,255,.14);
            color: #fff;
        }
        .nav-menu a.active { box-shadow: inset 0 -2px 0 var(--gold-bright); }

        .caret {
            font-size: 10px;
            opacity: .8;
            transition: transform .2s ease;
        }
        .has-menu.open .caret { transform: rotate(180deg); }

        /* ---------- Dropdown ---------- */
        .submenu {
            list-style: none;
            margin: 0;
            padding: 6px;
            min-width: 230px;
            background: #fff;
            border: 1px solid var(--rule);
            border-radius: 8px;
            box-shadow: 0 12px 32px rgba(20,10,50,.16);
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            transition: opacity .18s ease, transform .18s ease, visibility .18s;
        }
        .has-menu.open .submenu,
        .has-menu:focus-within .submenu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        .submenu a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 6px;
            font-size: 14px;
            color: var(--ink);
            background: transparent;
            width: 100%;
        }
        .submenu a:hover {
            background: var(--brand-soft);
            color: var(--brand-1);
        }
        .submenu a i {
            width: 16px;
            text-align: center;
            color: var(--brand-1);
        }
        .submenu .divider {
            height: 1px;
            background: var(--rule);
            margin: 4px 6px;
        }

        /* ---------- Cart pill ---------- */
        .cart-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 999px;
            color: #fff;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            margin-left: auto;
            transition: background .15s ease, transform .15s ease;
        }
        .cart-link:hover {
            background: rgba(255,255,255,.26);
            color: #fff;
            transform: translateY(-1px);
        }
        .cart-link .count {
            background: var(--gold-bright);
            color: var(--brand-3);
            border-radius: 999px;
            padding: 1px 8px;
            font-size: 12px;
            font-weight: 700;
            min-width: 22px;
            text-align: center;
            line-height: 1.5;
        }

        /* ---------- Login partial wrapper ---------- */
        .login-slot {
            display: flex;
            align-items: center;
        }
        .login-slot > * { margin: 0 !important; }

        .login-slot ul,
        .login-slot .navbar-nav {
            list-style: none;
            margin: 0 !important;
            padding: 0 !important;
            display: flex !important;
            flex-direction: row !important;
            align-items: center;
            gap: 4px;
        }
        .login-slot li {
            display: inline-flex;
            align-items: center;
            margin: 0 !important;
        }
        .login-slot form {
            margin: 0 !important;
            padding: 0 !important;
            display: inline-flex;
        }

        .login-slot a,
        .login-slot button,
        .login-slot .nav-link,
        .login-slot .btn-link {
            display: inline-flex !important;
            align-items: center;
            color: rgba(255,255,255,.92) !important;
            text-decoration: none !important;
            padding: 8px 12px !important;
            border-radius: 6px !important;
            font-family: inherit;
            font-size: 14px !important;
            font-weight: 500;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            white-space: nowrap;
            transition: background .15s ease, color .15s ease;
        }
        .login-slot a:hover,
        .login-slot button:hover,
        .login-slot .nav-link:hover {
            background: rgba(255,255,255,.14) !important;
            color: #fff !important;
        }

        /* ================= MAIN ================= */
        main.site-main {
            max-width: 1400px;
            margin: 0 auto;
            padding: 32px 22px 60px;
        }

        /* ================= FOOTER ================= */
        .site-footer {
            background: #1a1425;
            color: rgba(255,255,255,.75);
            margin-top: 80px;
            padding: 48px 22px 26px;
        }
        .footer-inner {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr 1fr;
            gap: 40px;
        }
        .footer-brand {
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-size: 26px;
            color: #fff;
            margin: 0 0 10px;
        }
        .footer-brand em { color: var(--gold-bright); font-style: italic; }
        .footer-inner p { font-size: 14px; line-height: 1.6; margin: 0; }

        .footer-col h4 {
            color: #fff;
            font-size: 13px;
            letter-spacing: .16em;
            text-transform: uppercase;
            margin: 0 0 16px;
            font-weight: 600;
        }
        .footer-col a {
            display: block;
            color: rgba(255,255,255,.72);
            text-decoration: none;
            padding: 6px 0;
            font-size: 14px;
            transition: color .15s ease;
        }
        .footer-col a:hover { color: var(--gold-bright); }

        .footer-bottom {
            max-width: 1400px;
            margin: 40px auto 0;
            padding-top: 22px;
            border-top: 1px solid rgba(255,255,255,.12);
            display: flex;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            font-size: 13px;
            color: rgba(255,255,255,.55);
        }

        /* ================= RESPONSIVE ================= */
        @@media (max-width: 992px) {
            .footer-inner { grid-template-columns: 1fr 1fr; }
        }

        @@media (max-width: 820px) {
            .site-nav {
                padding: 10px 16px;
                gap: 10px;
            }

            .nav-toggle {
                display: inline-flex;
                margin-left: auto;
                order: 2;
            }

            .cart-link {
                order: 3;
                margin-left: 0;
                padding: 7px 12px;
                font-size: 13px;
            }

            .login-slot {
                order: 3;
            }

            .nav-menu {
                order: 4;
                display: none;
                flex-direction: column;
                align-items: stretch;
                width: 100%;
                padding: 10px 0 14px;
                gap: 2px;
                border-top: 1px solid rgba(255,255,255,.12);
                margin-top: 6px;
            }
            .nav-menu.open { display: flex; }

            .nav-menu a,
            .nav-menu button.nav-trigger {
                width: 100%;
                padding: 12px 14px;
                font-size: 15px;
            }

            .submenu {
                position: static;
                opacity: 1;
                visibility: visible;
                transform: none;
                box-shadow: none;
                border: none;
                background: rgba(0,0,0,.18);
                padding: 4px;
                margin-top: 4px;
                display: none;
            }
            .has-menu.open .submenu { display: block; }
            .submenu a { color: #fff !important; }
            .submenu a:hover { background: rgba(255,255,255,.12); color: #fff !important; }
            .submenu a i { color: var(--gold-bright); }

            .footer-inner { grid-template-columns: 1fr; }
            main.site-main { padding: 22px 16px 40px; }
        }
    </style>

    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- ================= HEADER ================= -->
    <header class="site-header">
        <nav class="site-nav" aria-label="Primary">

            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="mark" aria-hidden="true"><i class="fa-solid fa-book-open"></i></span>
                <span>Book<em> Store</em></span>
            </a>

            <button class="nav-toggle" id="navToggle" type="button"
                    aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>

            <ul class="nav-menu" id="navMenu">
                <li>
                    <a asp-area="" asp-controller="Home" asp-action="Index"
                       class="@Active("Home")">
                        Home
                    </a>
                </li>

                @* ---------- Customer: My Orders ---------- *@
                @if (isAuthenticated && !isStaff)
                {
                    <li>
                        <a asp-area="Customer" asp-controller="Order" asp-action="Index"
                           class="@Active("Order", null, "Customer")">
                            My Orders
                        </a>
                    </li>
                }

                @if (isEmployee && isAdmin)
                {
                    <li class="has-menu" data-menu>
                        <button type="button" class="nav-trigger"
                                aria-haspopup="true" aria-expanded="false">
                            Content <i class="fa-solid fa-chevron-down caret" aria-hidden="true"></i>
                        </button>
                        <ul class="submenu">
                            <li><a asp-area="Admin" asp-controller="Category" asp-action="Index"><i class="fa-solid fa-tag"></i>Category</a></li>
                            <li><a asp-area="Admin" asp-controller="CoverTypes" asp-action="Index"><i class="fa-solid fa-book"></i>Cover Types</a></li>
                            <li class="divider" role="separator"></li>
                            <li><a asp-area="Admin" asp-controller="Product" asp-action="Index"><i class="fa-solid fa-box"></i>Product</a></li>
                        </ul>
                    </li>
                }

                @if (isAdmin)
                {
                    <li class="has-menu" data-menu>
                        <button type="button" class="nav-trigger"
                                aria-haspopup="true" aria-expanded="false">
                            Manage <i class="fa-solid fa-chevron-down caret" aria-hidden="true"></i>
                        </button>
                        <ul class="submenu">
                            <li><a asp-area="Admin" asp-controller="Company" asp-action="Index"><i class="fa-solid fa-building"></i>Company</a></li>
                            <li><a asp-area="Admin" asp-controller="User" asp-action="Index"><i class="fa-solid fa-users"></i>Users</a></li>
                        </ul>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="Order" asp-action="Index"
                           class="@Active("Order", null, "Admin")">
                            Orders
                        </a>
                    </li>
                }
            </ul>

            <a class="cart-link" asp-area="Customer" asp-controller="Cart" asp-action="Index"
               aria-label="Cart, @cartCount items">
                <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                <span class="count">@cartCount</span>
            </a>

            <div class="login-slot">
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <!-- ================= MAIN ================= -->
    <main id="main" class="site-main" role="main">
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="site-footer">
        <div class="footer-inner">
            <div>
                <h3 class="footer-brand">Book <em>Store</em></h3>
                <p>Fine books, carefully chosen. Independent since MMXXV — for readers who linger.</p>
            </div>
            <div class="footer-col">
                <h4>Shop</h4>
                <a asp-area="" asp-controller="Home" asp-action="Index">Catalogue</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-sortOrder="bestseller">Bestsellers</a>
                <a asp-area="Customer" asp-controller="Cart" asp-action="Index">Your Cart</a>
            </div>
            <div class="footer-col">
                <h4>Account</h4>
                @if (isAuthenticated)
                {
                    <a asp-area="Customer" asp-controller="Order" asp-action="Index">My Orders</a>
                }
                <a asp-area="Identity" asp-page="/Account/Manage/Index">Profile</a>
                <a asp-area="Identity" asp-page="/Account/Manage/Email">Email</a>
                <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword">Password</a>
            </div>
            <div class="footer-col">
                <h4>About</h4>
                <a href="#">Our Story</a>
                <a href="#">Shipping</a>
                <a href="#">Return</a>
            </div>
        </div>
        <div class="footer-bottom">
            <span>&copy; @DateTime.UtcNow.Year Book Store · All rights reserved</span>
            <span>Made by M🔺Y🔺N K</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js"
            integrity="sha512-AA1Bzp5Q0K1KanKKmvN/4d3IRKVlv9PYgwFPvm32nPO6QS8yH1HO7LbgB1pgiOxPtfeg5zEn2ba64MUcqJx6CA=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://kit.fontawesome.com/e19c476714.js" crossorigin="anonymous"></script>

    <script>
        (function () {
            'use strict';

            var toggle = document.getElementById('navToggle');
            var menu = document.getElementById('navMenu');
            if (toggle && menu) {
                toggle.addEventListener('click', function () {
                    var open = menu.classList.toggle('open');
                    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
            }

            document.querySelectorAll('[data-menu]').forEach(function (li) {
                var trigger = li.querySelector('.nav-trigger');
                if (!trigger) return;

                trigger.addEventListener('click', function (e) {
                    e.preventDefault();
                    var open = li.classList.toggle('open');
                    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
            });

            document.addEventListener('click', function (e) {
                document.querySelectorAll('[data-menu].open').forEach(function (li) {
                    if (!li.contains(e.target)) {
                        li.classList.remove('open');
                        var t = li.querySelector('.nav-trigger');
                        if (t) t.setAttribute('aria-expanded', 'false');
                    }
                });
            });

            document.addEventListener('keydown', function (e) {
                if (e.key !== 'Escape') return;
                document.querySelectorAll('[data-menu].open').forEach(function (li) {
                    li.classList.remove('open');
                    var t = li.querySelector('.nav-trigger');
                    if (t) t.setAttribute('aria-expanded', 'false');
                });
                if (menu) menu.classList.remove('open');
                if (toggle) toggle.setAttribute('aria-expanded', 'false');
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>