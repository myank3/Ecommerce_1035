@model Ecommerce_1035.Models.Models.Company

@{
	var title = Model.Id != 0 ? "Edit Company " : "New Company";
	//var saveUpdate = Model.Id != 0 ? "Update" : "Save";
}

<h2 class="text-info text-center">@title</h2>
<form method="post">
	@if (Model.Id != 0)
	{
		<input type="hidden" asp-for="Id" />
	}
	<div class="col-8">
		<label asp-for="Name" class="form-control-plaintext fw-bold">Name</label>
		<input asp-for="Name" class="form-control" />
		<span asp-validation-for="Name"> </span>
	</div>
	<div class="col-8">
		<label asp-for="StreetAddress" class="form-control-plaintext fw-bold">Street Address</label>
		<input asp-for="StreetAddress" class="form-control" />
		<span asp-validation-for="StreetAddress"> </span>
	</div>
	<div class="col-8">
		<label asp-for="City" class="form-control-plaintext fw-bold">City</label>
		<input asp-for="City" class="form-control" />
		<span asp-validation-for="City"> </span>
	</div>
	<div class="col-8">
		<label asp-for="State" class="form-control-plaintext fw-bold">State</label>
		<input asp-for="State" class="form-control" />
		<span asp-validation-for="State"> </span>
	</div>
	<div class="col-8">
		<label asp-for="PostalCode" class="form-control-plaintext fw-bold">Postal Code</label>
		<input asp-for="PostalCode" class="form-control" />
		<span asp-validation-for="PostalCode"> </span>
	</div>
	<div class="col-8">
		<div class="form-check">
			<input type="checkbox" asp-for="IsAuthorizedCompany" class="form-check-input" />
			<label asp-for="IsAuthorizedCompany" class="form-check-label fw-bold">Is Authorized Company</label>
		</div>
	</div>


	<div class="form-group row p-2 m-2">
		<div class="col-8 offset-4">
			@if (Model.Id != 0)
			{
				<partial name="_EditandBack" />
			}
			else
			{
				<partial name="_CreateandBack" />
			}
		</div>
	</div>
</form>
