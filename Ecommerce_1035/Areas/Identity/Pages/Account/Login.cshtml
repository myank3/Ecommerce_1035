@page
@using Ecommerce_1035.Utilities
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
}

@section Head {
    <style>
        /* ============================================================
                   LOGIN PAGE
                ============================================================ */
        .login-page {
            --brand-1: #6c2bd9;
            --brand-2: #8b3dff;
            --brand-3: #4c1d95;
            --brand-soft: #f3f0fb;
            --ink: #14110d;
            --ink-soft: #5c5449;
            --paper: #f7f4ee;
            --paper-2: #ece4d3;
            --rule: #cfc4ac;
            --rule-dark: #9c8a68;
            --gold: #8a6c34;
            --accent: #6b2a2a;
            --serif: 'Cormorant Garamond', Georgia, serif;
            --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        .login-wrap {
            max-width: 1080px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .login-card {
            display: grid;
            grid-template-columns: 1fr 380px;
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 1px 3px rgba(20,10,50,.06), 0 24px 60px -30px rgba(20,10,50,.35);
        }

        /* ============================================================
                   FORM SIDE
                ============================================================ */
        .form-side {
            padding: 48px 52px;
        }

            .form-side .brand-mark {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                font-family: var(--serif);
                font-size: 20px;
                font-weight: 700;
                color: var(--ink);
                text-decoration: none;
                margin-bottom: 32px;
            }

                .form-side .brand-mark em {
                    font-style: italic;
                    font-weight: 400;
                    color: var(--brand-1);
                }

                .form-side .brand-mark .dot {
                    width: 30px;
                    height: 30px;
                    border-radius: 8px;
                    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
                    display: grid;
                    place-items: center;
                    color: #fff;
                    font-size: 14px;
                }

            .form-side h1 {
                font-family: var(--serif);
                font-size: 2rem;
                font-weight: 700;
                letter-spacing: -.01em;
                margin: 0 0 8px;
                color: var(--ink);
            }

            .form-side .subtitle {
                font-size: 14.5px;
                color: var(--ink-soft);
                margin: 0 0 32px;
                line-height: 1.55;
            }

        /* ---------- Inputs ---------- */
        .field {
            position: relative;
            margin-bottom: 14px;
        }

            .field .form-control {
                width: 100%;
                background: var(--paper);
                border: 1px solid var(--rule);
                border-radius: 8px;
                padding: 14px 16px 14px 44px;
                font-family: var(--sans);
                font-size: 14.5px;
                color: var(--ink);
                transition: border-color .15s, background .15s, box-shadow .15s;
                height: auto;
            }

                .field .form-control::placeholder {
                    color: #a89d8a;
                }

                .field .form-control:focus {
                    outline: none;
                    border-color: var(--brand-1);
                    background: #fff;
                    box-shadow: 0 0 0 3px rgba(108,43,217,.12);
                }

                .field .form-control.input-validation-error {
                    border-color: #dc2626;
                    background: #fef2f2;
                }

            .field .field-icon {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--rule-dark);
                font-size: 14px;
                pointer-events: none;
                transition: color .15s;
            }

            .field .form-control:focus ~ .field-icon {
                color: var(--brand-1);
            }

            .field .validation-message {
                display: block;
                font-family: var(--sans);
                font-size: 12px;
                color: #dc2626;
                margin-top: 4px;
                padding-left: 4px;
            }

            /* Password toggle */
            .field .toggle-pw {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                background: transparent;
                border: none;
                color: var(--rule-dark);
                cursor: pointer;
                padding: 6px;
                font-size: 14px;
                line-height: 1;
                transition: color .15s;
            }

                .field .toggle-pw:hover {
                    color: var(--brand-1);
                }

        /* Remember + forgot row */
        .remember-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 4px 0 20px;
            flex-wrap: wrap;
        }

            .remember-row .form-check {
                display: flex;
                align-items: center;
                gap: 8px;
                margin: 0;
                font-family: var(--sans);
                font-size: 13.5px;
                color: var(--ink-soft);
            }

            .remember-row .form-check-input {
                width: 16px;
                height: 16px;
                margin: 0;
                border: 1px solid var(--rule-dark);
                border-radius: 4px;
                cursor: pointer;
                accent-color: var(--brand-1);
            }

            .remember-row .forgot {
                font-family: var(--sans);
                font-size: 13.5px;
                color: var(--brand-1);
                text-decoration: none;
                font-weight: 500;
            }

                .remember-row .forgot:hover {
                    text-decoration: underline;
                }

        /* Submit button */
        .btn-login {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 14px 24px;
            font-family: var(--sans);
            font-size: 15px;
            font-weight: 600;
            letter-spacing: .01em;
            cursor: pointer;
            transition: transform .15s, box-shadow .15s;
            box-shadow: 0 8px 22px -10px rgba(108,43,217,.55);
        }

            .btn-login:hover {
                transform: translateY(-1px);
                box-shadow: 0 12px 28px -10px rgba(108,43,217,.7);
            }

            .btn-login:active {
                transform: translateY(0);
            }

        /* Register prompt */
        .register-prompt {
            text-align: center;
            font-family: var(--sans);
            font-size: 13.5px;
            color: var(--ink-soft);
            margin: 20px 0 0;
        }

            .register-prompt a {
                color: var(--brand-1);
                font-weight: 600;
                text-decoration: none;
            }

                .register-prompt a:hover {
                    text-decoration: underline;
                }

        /* Utility links row */
        .utility-links {
            display: flex;
            flex-wrap: wrap;
            gap: 6px 20px;
            justify-content: center;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--rule);
            font-family: var(--sans);
            font-size: 12.5px;
        }

            .utility-links a {
                color: var(--ink-soft);
                text-decoration: none;
                transition: color .15s;
            }

                .utility-links a:hover {
                    color: var(--brand-1);
                }

        /* Validation summary */
        .validation-summary {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-left: 4px solid #dc2626;
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 22px;
            font-size: 13.5px;
            color: #991b1b;
        }

            .validation-summary:empty,
            .validation-summary.validation-summary-valid {
                display: none;
            }

            .validation-summary ul {
                margin: 4px 0 0;
                padding-left: 18px;
            }

                .validation-summary ul li {
                    margin-bottom: 2px;
                }

        /* ============================================================
                   SIDE PANEL
                ============================================================ */
        .side-panel {
            background: radial-gradient(circle at 90% 10%, rgba(253,230,138,.14) 0%, transparent 40%), radial-gradient(circle at 10% 90%, rgba(168,85,247,.28) 0%, transparent 45%), linear-gradient(160deg, #1a0b3d 0%, #2d1a4a 45%, #4c1d95 100%);
            color: #fff;
            padding: 48px 36px;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

            .side-panel::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: radial-gradient(circle at 80% 15%, rgba(255,255,255,.08) 0%, transparent 30%);
                pointer-events: none;
            }

            .side-panel h2 {
                font-family: var(--serif);
                font-size: 1.6rem;
                font-weight: 500;
                font-style: italic;
                line-height: 1.2;
                margin: 0 0 12px;
                color: #fff;
                position: relative;
            }

                .side-panel h2 em {
                    color: #fde68a;
                }

            .side-panel .lead {
                font-size: 14px;
                line-height: 1.6;
                color: rgba(255,255,255,.75);
                margin: 0 0 28px;
                position: relative;
            }

        .quote {
            font-family: var(--serif);
            font-style: italic;
            font-size: 1.05rem;
            line-height: 1.55;
            color: rgba(255,255,255,.85);
            padding: 20px 0 20px 20px;
            border-left: 2px solid rgba(253,230,138,.45);
            margin: 0 0 24px;
            position: relative;
        }

            .quote cite {
                display: block;
                margin-top: 12px;
                font-size: .85rem;
                font-style: normal;
                letter-spacing: .04em;
                color: rgba(255,255,255,.6);
            }

        .perks {
            list-style: none;
            margin: 0 0 auto;
            padding: 0;
            position: relative;
        }

            .perks li {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                padding: 12px 0;
                border-bottom: 1px solid rgba(255,255,255,.08);
                font-size: 14px;
                color: rgba(255,255,255,.88);
            }

                .perks li:last-child {
                    border-bottom: none;
                }

            .perks .perk-icon {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                background: rgba(255,255,255,.12);
                border: 1px solid rgba(255,255,255,.2);
                display: grid;
                place-items: center;
                font-size: 13px;
                color: #fde68a;
                flex-shrink: 0;
            }

        /* Divider with "OR" */
        .side-divider {
            display: flex;
            align-items: center;
            gap: 14px;
            margin: 32px 0 20px;
            font-family: var(--sans);
            font-size: 11px;
            letter-spacing: .28em;
            text-transform: uppercase;
            color: rgba(255,255,255,.5);
            position: relative;
        }

            .side-divider::before,
            .side-divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: rgba(255,255,255,.14);
            }

        /* External provider buttons */
        .external-buttons {
            display: grid;
            gap: 10px;
            position: relative;
        }

        .btn-external {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.22);
            border-radius: 9px;
            padding: 11px 16px;
            font-family: var(--sans);
            font-size: 13.5px;
            font-weight: 500;
            color: #fff;
            text-decoration: none;
            cursor: pointer;
            transition: background .15s, border-color .15s, transform .15s;
        }

            .btn-external:hover {
                background: rgba(255,255,255,.16);
                border-color: rgba(255,255,255,.35);
                color: #fff;
                transform: translateY(-1px);
            }

            .btn-external i {
                font-size: 15px;
            }

        .no-providers {
            font-size: 13px;
            line-height: 1.55;
            color: rgba(255,255,255,.6);
            padding: 12px 14px;
            background: rgba(255,255,255,.06);
            border: 1px dashed rgba(255,255,255,.18);
            border-radius: 8px;
            margin: 0;
        }

            .no-providers a {
                color: #fde68a;
            }

        /* ============================================================
                   RESPONSIVE
                ============================================================ */
        @@media (max-width: 900px) {
            .login-card {
                grid-template-columns: 1fr;
            }

            .side-panel {
                padding: 36px 32px;
                order: -1;
            }

                .side-panel h2 {
                    font-size: 1.35rem;
                }

            .form-side {
                padding: 36px 28px;
            }
        }

        @@media (max-width: 520px) {
            .login-wrap {
                margin: 20px auto;
            }

            .form-side {
                padding: 28px 22px;
            }

                .form-side h1 {
                    font-size: 1.6rem;
                }
        }
    </style>
}

<div class="login-page">
    <div class="login-wrap">
        <div class="login-card">

            <!-- ============================================================
                 FORM SIDE
            ============================================================ -->
            <div class="form-side">

                <a asp-area="" asp-controller="Home" asp-action="Index" class="brand-mark">
                    <span class="dot" aria-hidden="true"><i class="fa-solid fa-book-open"></i></span>
                    <span>Book<em> Store</em></span>
                </a>

                <h1>Welcome back</h1>
                <p class="subtitle">
                    Sign in to pick up where you left off —
                    your cart, your wish list, your reading list.
                </p>

                <form id="account" method="post" novalidate>

                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                    <div class="field">
                        <input asp-for="Input.Email" class="form-control"
                               autocomplete="username" aria-required="true"
                               placeholder="you@example.com" />
                        <i class="fa-solid fa-envelope field-icon" aria-hidden="true"></i>
                        <span asp-validation-for="Input.Email" class="validation-message"></span>
                    </div>

                    <div class="field">
                        <input asp-for="Input.Password" class="form-control"
                               autocomplete="current-password" aria-required="true"
                               placeholder="Password"
                               id="passwordInput" />
                        <i class="fa-solid fa-lock field-icon" aria-hidden="true"></i>
                        <button type="button" class="toggle-pw" id="togglePassword"
                                aria-label="Show password">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                        <span asp-validation-for="Input.Password" class="validation-message"></span>
                    </div>

                    <div class="remember-row">
                        <label class="form-check" asp-for="Input.RememberMe">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <span>Remember me</span>
                        </label>
                        <a id="forgot-password" class="forgot"
                           asp-page="./ForgotPassword">Forgot password?</a>
                    </div>

                    <button id="login-submit" type="submit" class="btn-login">
                        <i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i>
                        Sign In
                    </button>

                    <p class="register-prompt">
                        New to The Reading Room?
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
                    </p>

                    <div class="utility-links">
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">
                            Resend email confirmation
                        </a>
                    </div>
                </form>
            </div>

            <!-- ============================================================
                 SIDE PANEL
            ============================================================ -->
            <aside class="side-panel">

                <h2>A <em>reader's</em><br />account.</h2>
                <p class="lead">
                    What you get when you sign in.
                </p>

                <blockquote class="quote">
                    “A room without books is like a body without a soul.”
                    <cite>— Cicero</cite>
                </blockquote>

                <ul class="perks">
                    <li>
                        <span class="perk-icon"><i class="fa-solid fa-bag-shopping"></i></span>
                        <span>Your cart, always saved</span>
                    </li>
                    <li>
                        <span class="perk-icon"><i class="fa-solid fa-clock-rotate-left"></i></span>
                        <span>Order history &amp; reorders in one tap</span>
                    </li>
                    <li>
                        <span class="perk-icon"><i class="fa-solid fa-bookmark"></i></span>
                        <span>Personal wish list, synced</span>
                    </li>
                    <li>
                        <span class="perk-icon"><i class="fa-solid fa-envelope-open-text"></i></span>
                        <span>Monthly reading recommendation</span>
                    </li>
                </ul>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="side-divider">or continue with</div>

                    <form id="external-account" asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div class="external-buttons">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                var icon = provider.Name switch
                                {
                                    "Google" => "fa-brands fa-google",
                                    "LinkedIn" => "fa-brands fa-linkedin-in",
                                    "Facebook" => "fa-brands fa-facebook-f",
                                    "GitHub" => "fa-brands fa-github",
                                    "Microsoft" => "fa-brands fa-microsoft",
                                    "Twitter" => "fa-brands fa-x-twitter",
                                    _ => "fa-solid fa-right-to-bracket"
                                };

                                <button type="submit"
                                        class="btn-external"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Sign in with your @provider.DisplayName account"
                                        aria-label="Sign in with @provider.DisplayName">
                                    <i class="@icon" aria-hidden="true"></i>
                                    <span>Continue with @provider.DisplayName</span>
                                </button>
                            }
                        </div>
                    </form>
                }
                else
                {
                    <p class="no-providers">
                        No external providers configured.
                        <a href="https://go.microsoft.com/fwlink/?LinkID=532715"
                           target="_blank" rel="noopener">Learn how to set one up →</a>
                    </p>
                }
            </aside>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';

            var toggle = document.getElementById('togglePassword');
            var input = document.getElementById('passwordInput');
            if (!toggle || !input) return;

            toggle.addEventListener('click', function () {
                var showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                toggle.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
                toggle.querySelector('i').className = showing
                    ? 'fa-solid fa-eye'
                    : 'fa-solid fa-eye-slash';
            });
        })();
    </script>
}