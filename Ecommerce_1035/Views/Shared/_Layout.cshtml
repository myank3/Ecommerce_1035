@using Ecommerce_1035.Utilities

@inject IHttpContextAccessor httpContextAccessor

@{
    var cartCount = httpContextAccessor.HttpContext?.Session.GetInt32(SD.Ss_CartSessionCount) ?? 0;
    var isAdmin = User.IsInRole(SD.Role_Admin);
    var isEmployee = User.IsInRole(SD.Role_Employee);
    var isStaff = isAdmin || isEmployee;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var currentController = (string?)ViewContext.RouteData.Values["controller"];
    var currentAction = (string?)ViewContext.RouteData.Values["action"];
    var currentArea = (string?)ViewContext.RouteData.Values["area"];

    string Active(string? controller, string? action = null, string? area = null)
    {
        var c = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        var a = action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        var ar = area == null || string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase);
        return c && a && ar ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2a2438" />
    <meta name="description" content="@(ViewData["Description"] ?? "Book Store — fine books, carefully chosen.")" />

    <title>@ViewData["Title"] · Book Store</title>

    <!-- Standard Favicon (Browser Tabs) -->
