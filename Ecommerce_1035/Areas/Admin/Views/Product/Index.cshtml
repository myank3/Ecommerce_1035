

<div class="container">
    <div>
        <h2 class="text-center text-info">Product List</h2>
    </div>
    <div>
        <div class="col-2text-end mb-3">
            <a asp-action="Upsert" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Product
            </a>
        </div>
        <table id="tblData" class="table table-bordered table-striped" style="width:100%">
            <thead>
                <tr>
                    <th> Title</th>
                    <th> Description</th>
                    <th> Author</th>
                    <th> ISBN</th>
                    <th> Price</th>
                    <th> Action</th>

                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
@section scripts
{
    <script src="~/js/product.js"></script>
}