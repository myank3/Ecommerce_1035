@model IEnumerable<Ecommerce_1035.Models.Models.Product>
@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "Book Store — fine books, carefully chosen. Fiction, essays, poetry, and bestsellers.";

    var currentSort = ViewBag.CurrentSort as string;
    var bestsellerQuantities = ViewBag.BestsellerQuantities as Dictionary<int, int>;
    var isBestseller = currentSort == "bestseller";
    var products = Model?.ToList() ?? new List<Ecommerce_1035.Models.Models.Product>();

    var heroBooks = products.Take(3).ToList();
}

@section Head {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <style>
        /* ===== GLOBAL SMOOTH SCROLL ===== */
        html {
            scroll-behavior: smooth;
        }

        .home {
            /* ===== CLEAN IVORY PALETTE ===== */
            --ink: #1e1a24;
            --ink-soft: #4c4658;
            --ink-faint: #8a8394;
            --paper: #f8f6f0;
            --paper-2: #f2efe7;
            --paper-3: #eae6db;
            --rule: #d4cfc0;
            --rule-soft: #e6e2d6;
            /* Brass */
            --brass: #a88b4a;
            --brass-deep: #7a6230;
            --brass-light: #d4b978;
            /* Poster surfaces */
            --poster: #faf8f2;
            --poster-2: #f3f0e8;
            /* Royal purple accents */
            --royal: #4c1d95;
            --royal-mid: #6c2bd9;
            --royal-deep: #2e1065;
            --royal-soft: #ede9fe;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: var(--ink);
            padding: 8px 0 60px;
            /* ==== MOUNTAIN-RANGE BACKGROUND ====
                       Layered SVG silhouette at very low opacity — reads as atmosphere,
                       not as decoration. Content sits cleanly on top. */
            background-color: var(--paper);
            background-image:
            /* Soft warm wash top-left */
            radial-gradient(ellipse 1400px 900px at 12% -10%, rgba(168,139,74,.05) 0%, transparent 60%),
            /* Soft cool wash bottom-right */
            radial-gradient(ellipse 1200px 800px at 92% 112%, rgba(76,29,149,.045) 0%, transparent 60%),
            /* Mountain range — three overlapping ridges in purple tones */
            url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1600' height='420' viewBox='0 0 1600 420' preserveAspectRatio='none'><defs><linearGradient id='ridgeBack' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='%234c1d95' stop-opacity='0.055'/><stop offset='1' stop-color='%234c1d95' stop-opacity='0.015'/></linearGradient><linearGradient id='ridgeMid' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='%232e1065' stop-opacity='0.070'/><stop offset='1' stop-color='%232e1065' stop-opacity='0.020'/></linearGradient><linearGradient id='ridgeFront' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='%23a88b4a' stop-opacity='0.085'/><stop offset='1' stop-color='%23a88b4a' stop-opacity='0.020'/></linearGradient></defs><path d='M0 300 L120 210 L220 260 L340 150 L460 240 L560 190 L680 100 L820 220 L940 160 L1060 240 L1180 180 L1300 260 L1420 190 L1540 250 L1600 220 L1600 420 L0 420 Z' fill='url(%23ridgeBack)'/><path d='M0 340 L160 250 L280 310 L400 200 L520 290 L640 240 L760 160 L880 270 L1000 210 L1120 290 L1240 240 L1360 310 L1480 250 L1600 300 L1600 420 L0 420 Z' fill='url(%23ridgeMid)'/><path d='M0 380 L180 310 L320 360 L460 270 L600 350 L740 300 L880 230 L1020 330 L1160 280 L1300 350 L1440 300 L1600 370 L1600 420 L0 420 Z' fill='url(%23ridgeFront)'/></svg>");
            background-position: center bottom;
            background-size: 100% auto;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        /* ==================================================
                                   HERO
                                ================================================== */
        .hero {
            position: relative;
            border-radius: 18px;
            overflow: hidden;
            background: linear-gradient(125deg, var(--poster-2) 0%, var(--poster) 55%, var(--poster-2) 100%);
            color: var(--ink);
            margin-bottom: 48px;
            min-height: 460px;
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            box-shadow: 0 40px 80px -40px rgba(20,14,30,.35), 0 12px 28px -14px rgba(20,14,30,.20), 0 0 0 1px rgba(122,98,48,.40) inset, inset 0 0 120px rgba(76,29,149,.05);
            transform: translateZ(0);
        }

            .hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse at center, transparent 50%, rgba(46,16,101,.08) 100%);
                pointer-events: none;
            }

            .hero::after {
                content: '';
                position: absolute;
                inset: 14px;
                border: 1px solid rgba(122,98,48,.40);
                border-radius: 10px;
                pointer-events: none;
                box-shadow: 0 0 0 1px rgba(255,255,255,.6) inset;
            }

        .hero-copy {
            padding: 64px 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            z-index: 2;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            align-self: flex-start;
            background: rgba(255,253,246,.85);
            border: 1px solid rgba(122,98,48,.40);
            color: var(--brass-deep);
            font-family: 'Inter', sans-serif;
            font-size: 10.5px;
            font-weight: 500;
            letter-spacing: .38em;
            text-transform: uppercase;
            padding: 8px 18px;
            border-radius: 2px;
            margin-bottom: 30px;
        }

            .hero-badge i {
                font-size: 10px;
                color: var(--royal);
            }

        .hero h1 {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 3.35rem;
            font-weight: 500;
            line-height: 1.08;
            margin: 0 0 22px;
            letter-spacing: -.015em;
            color: var(--ink);
            text-shadow: 0 1px 0 rgba(255,255,255,.7);
        }

            .hero h1 em {
                font-family: 'Cormorant Garamond', Georgia, serif;
                font-style: italic;
                font-weight: 500;
                color: var(--royal);
            }

        .hero p {
            font-size: 15.5px;
            line-height: 1.75;
            color: var(--ink-soft);
            max-width: 46ch;
            margin: 0 0 34px;
            font-weight: 400;
        }

        .hero-actions {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn-primary-hero,
        .btn-ghost-hero {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 500;
            letter-spacing: .22em;
            text-transform: uppercase;
            padding: 15px 28px;
            border-radius: 2px;
            text-decoration: none;
            transition: transform .2s ease, background .2s ease, border-color .2s ease, color .2s ease;
            white-space: nowrap;
        }

        .btn-primary-hero {
            background: linear-gradient(180deg, var(--royal-mid) 0%, var(--royal-deep) 100%);
            color: #fbf9f4;
            border: 1px solid var(--royal-deep);
            box-shadow: 0 12px 24px -12px rgba(46,16,101,.65), 0 1px 0 rgba(255,255,255,.15) inset;
        }

            .btn-primary-hero:hover {
                background: linear-gradient(180deg, #7c3aed 0%, var(--royal) 100%);
                color: #fbf9f4;
                transform: translateY(-2px);
                box-shadow: 0 16px 28px -12px rgba(46,16,101,.8), 0 1px 0 rgba(255,255,255,.2) inset;
            }

        .btn-ghost-hero {
            background: transparent;
            color: var(--ink);
            border: 1px solid rgba(122,98,48,.5);
        }

            .btn-ghost-hero:hover {
                background: rgba(255,253,246,.8);
                border-color: var(--royal);
                color: var(--royal);
                transform: translateY(-2px);
            }

        /* ---------- HERO VISUAL ---------- */
        .hero-visual {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        .hero-stack {
            position: relative;
            width: 100%;
            max-width: 340px;
            height: 340px;
        }

        .hero-book {
            position: absolute;
            width: 155px;
            height: 228px;
            border-radius: 3px 6px 6px 3px;
            overflow: hidden;
            background: var(--paper-2);
            box-shadow: 0 32px 54px -22px rgba(20,14,30,.55), 0 0 0 1px rgba(122,98,48,.55), 0 0 0 6px rgba(255,253,246,.4);
        }

            .hero-book img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            .hero-book::after {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 12px;
                background: linear-gradient(to right, rgba(20,14,30,.5), transparent);
                pointer-events: none;
            }

            .hero-book:nth-child(1) {
                transform: rotate(-9deg) translate(-44px, 16px);
                z-index: 1;
                filter: brightness(.94);
            }

            .hero-book:nth-child(2) {
                transform: rotate(2deg) translate(12px, -14px);
                z-index: 3;
            }

            .hero-book:nth-child(3) {
                transform: rotate(10deg) translate(74px, 24px);
                z-index: 2;
                filter: brightness(.97);
            }

                .hero-book:nth-child(1):only-child,
                .hero-book:nth-child(2):nth-last-child(1),
                .hero-book:nth-child(3):nth-last-child(1) {
                    transform: rotate(0);
                    left: 50%;
                    margin-left: -77px;
                }

            .hero-book:nth-child(2):nth-last-child(2) {
                transform: rotate(-6deg) translate(-32px, 0);
            }

            .hero-book:nth-child(3):nth-last-child(2) {
                transform: rotate(6deg) translate(32px, 0);
            }

        /* ==================================================
                                   TRUST STRIP
                                ================================================== */
        .trust {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            background: var(--paper-2);
            border: 1px solid var(--rule);
            border-radius: 4px;
            overflow: hidden;
            margin-bottom: 60px;
            box-shadow: 0 8px 20px -12px rgba(20,14,30,.15), 0 1px 0 rgba(255,255,255,.7) inset;
            transform: translateZ(0);
        }

        .trust-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 24px 26px;
            border-right: 1px solid var(--rule-soft);
        }

            .trust-item:last-child {
                border-right: none;
            }

        .trust-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(180deg, #fdfcf7, #ece8dc);
            color: var(--royal);
            display: grid;
            place-items: center;
            font-size: 15px;
            flex-shrink: 0;
            border: 1px solid var(--rule);
            box-shadow: 0 2px 6px -2px rgba(20,14,30,.15), 0 1px 0 rgba(255,255,255,.7) inset;
        }

        .trust-text strong {
            display: block;
            font-family: 'Playfair Display', serif;
            font-size: 14px;
            font-weight: 600;
            color: var(--ink);
            letter-spacing: .01em;
            margin-bottom: 2px;
        }

        .trust-text span {
            font-size: 11.5px;
            color: var(--ink-faint);
            font-weight: 400;
            letter-spacing: .02em;
        }

        /* ==================================================
                                   SECTION HEAD
                                ================================================== */
        .section {
            margin-bottom: 68px;
        }

        .section-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 32px;
            flex-wrap: wrap;
            border-bottom: 1px solid var(--rule-soft);
            padding-bottom: 20px;
            position: relative;
        }

            .section-head::after {
                content: '';
                position: absolute;
                left: 0;
                bottom: -1px;
                width: 60px;
                height: 1px;
                background: linear-gradient(90deg, var(--brass), transparent);
            }

            .section-head .kicker {
                font-family: 'Inter', sans-serif;
                font-size: 10px;
                letter-spacing: .48em;
                text-transform: uppercase;
                color: var(--brass-deep);
                margin-bottom: 8px;
                font-weight: 500;
            }

            .section-head h2 {
                font-family: 'Playfair Display', Georgia, serif;
                font-size: 2.05rem;
                font-weight: 500;
                margin: 0;
                color: var(--ink);
                line-height: 1.1;
                letter-spacing: -.01em;
            }

                .section-head h2 em {
                    font-family: 'Cormorant Garamond', Georgia, serif;
                    font-style: italic;
                    color: var(--royal);
                    font-weight: 500;
                }

            .section-head .more {
                font-family: 'Inter', sans-serif;
                font-size: 10.5px;
                font-weight: 600;
                letter-spacing: .28em;
                text-transform: uppercase;
                color: var(--ink-soft);
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: color .2s ease, gap .2s ease;
            }

                .section-head .more:hover {
                    color: var(--royal);
                    gap: 10px;
                }

        /* ==================================================
                                   DATATABLE
                                ================================================== */
        #tblData_wrapper {
            margin-top: 8px;
        }

            #tblData_wrapper .dataTables_length,
            #tblData_wrapper .dataTables_filter {
                font-family: 'Inter', sans-serif;
                font-size: 11px;
                letter-spacing: .16em;
                text-transform: uppercase;
                color: var(--ink-faint);
                margin: 0 0 22px;
                font-weight: 500;
            }

            #tblData_wrapper .dataTables_filter {
                float: right;
            }

            #tblData_wrapper .dataTables_length {
                float: left;
            }

                #tblData_wrapper .dataTables_length select,
                #tblData_wrapper .dataTables_filter input {
                    border: none;
                    border-bottom: 1px solid var(--rule);
                    background: transparent;
                    border-radius: 0;
                    padding: 8px 4px;
                    font-family: 'Playfair Display', serif;
                    font-style: italic;
                    font-size: 15px;
                    color: var(--ink);
                    margin-left: 8px;
                    letter-spacing: 0;
                    text-transform: none;
                    transition: border-color .2s ease;
                }

            #tblData_wrapper .dataTables_filter input {
                min-width: 240px;
            }

                #tblData_wrapper .dataTables_length select:focus,
                #tblData_wrapper .dataTables_filter input:focus {
                    outline: none;
                    border-bottom-color: var(--royal);
                }

            #tblData_wrapper .dataTables_info,
            #tblData_wrapper .dataTables_paginate {
                font-family: 'Inter', sans-serif;
                font-size: 11px;
                letter-spacing: .14em;
                text-transform: uppercase;
                color: var(--ink-faint);
                margin: 24px 0 0;
                font-weight: 500;
            }

                #tblData_wrapper .dataTables_paginate .paginate_button {
                    font-family: 'Inter', sans-serif !important;
                    font-size: 12px !important;
                    letter-spacing: .1em !important;
                    color: var(--ink-soft) !important;
                    padding: 8px 14px !important;
                    border-radius: 2px !important;
                    border: 1px solid transparent !important;
                    background: transparent !important;
                    margin: 0 3px !important;
                    transition: all .2s ease;
                }

                    #tblData_wrapper .dataTables_paginate .paginate_button:hover {
                        background: var(--paper-2) !important;
                        border-color: var(--rule) !important;
                        color: var(--ink) !important;
                    }

                    #tblData_wrapper .dataTables_paginate .paginate_button.current {
                        background: linear-gradient(180deg, var(--royal-mid) 0%, var(--royal-deep) 100%) !important;
                        border-color: var(--royal-deep) !important;
                        color: #fbf9f4 !important;
                        font-weight: 700 !important;
                        box-shadow: 0 4px 10px -4px rgba(46,16,101,.55);
                    }

                    #tblData_wrapper .dataTables_paginate .paginate_button.disabled {
                        opacity: .3;
                    }

        /* ---------- GRID TRICK ---------- */
        #tblData {
            border-collapse: separate;
            border-spacing: 0;
            margin: 0;
            display: block;
            width: 100%;
            background: transparent;
        }

            #tblData > thead {
                display: none;
            }

            #tblData > tbody {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 34px 26px;
            }

                #tblData > tbody > tr {
                    display: contents;
                }

                    #tblData > tbody > tr > td {
                        display: block;
                        border: none;
                        padding: 0;
                    }

        /* ---------- BOOK CARD ---------- */
        .book {
            display: flex;
            flex-direction: column;
            text-decoration: none;
            color: var(--ink);
            border-radius: 3px;
            transition: transform .35s cubic-bezier(.2,.8,.2,1);
            height: 100%;
        }

            .book:hover {
                transform: translateY(-6px);
            }

            .book .cover-wrap {
                position: relative;
                border-radius: 3px;
                overflow: hidden;
                background: var(--paper-2);
                padding: 10px;
                box-shadow: 0 12px 26px -12px rgba(20,14,30,.35), 0 4px 10px -4px rgba(20,14,30,.20), 0 0 0 1px rgba(20,14,30,.08), 0 1px 0 rgba(255,255,255,.7) inset;
                transition: box-shadow .35s ease;
                transform: translateZ(0);
            }

            .book:hover .cover-wrap {
                box-shadow: 0 28px 52px -20px rgba(76,29,149,.40), 0 8px 20px -8px rgba(20,14,30,.25), 0 0 0 1px var(--royal), 0 0 0 4px rgba(108,43,217,.12), 0 1px 0 rgba(255,255,255,.8) inset;
            }

            .book .cover-wrap::after {
                content: '';
                position: absolute;
                inset: 10px;
                background: linear-gradient(135deg, rgba(212,185,120,.30) 0%, transparent 32%, transparent 68%, rgba(212,185,120,.20) 100%);
                opacity: 0;
                transition: opacity .4s ease;
                pointer-events: none;
                z-index: 2;
                border-radius: 2px;
            }

            .book:hover .cover-wrap::after {
                opacity: 1;
            }

            .book .cover {
                aspect-ratio: 2 / 3;
                overflow: hidden;
                position: relative;
                border-radius: 2px;
                box-shadow: 0 2px 8px -3px rgba(0,0,0,.32);
                z-index: 1;
            }

                .book .cover img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                    transition: transform .6s ease;
                    filter: sepia(.05) contrast(1.02);
                }

            .book:hover .cover img {
                transform: scale(1.045);
            }

            .book .tag {
                position: absolute;
                top: 18px;
                left: 18px;
                z-index: 4;
                font-family: 'Inter', sans-serif;
                font-size: 9.5px;
                font-weight: 600;
                letter-spacing: .24em;
                text-transform: uppercase;
                padding: 6px 11px;
                border-radius: 2px;
                background: linear-gradient(180deg, var(--royal-mid) 0%, var(--royal-deep) 100%);
                color: #fbf9f4;
                border: 1px solid rgba(212,185,120,.45);
                box-shadow: 0 4px 10px -4px rgba(0,0,0,.45);
            }

                .book .tag.sale {
                    background: linear-gradient(180deg, #6c2bd9 0%, var(--royal) 100%);
                    color: #f6f1e6;
                    border-color: rgba(246,241,230,.28);
                }

                .book .tag.best {
                    background: linear-gradient(180deg, #8f7340 0%, var(--brass-deep) 100%);
                    color: #f8f3e8;
                    border-color: rgba(248,243,232,.35);
                }

            .book .meta {
                padding: 18px 4px 0;
            }

        .book-title {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 1.08rem;
            font-weight: 600;
            line-height: 1.28;
            margin: 0 0 6px;
            color: var(--ink);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 44px;
            transition: color .2s;
            letter-spacing: -.005em;
        }

        .book:hover .book-title {
            color: var(--royal);
        }

        .book-author {
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-style: italic;
            font-size: 14px;
            color: var(--ink-faint);
            margin-bottom: 12px;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
            letter-spacing: .01em;
        }

        .book-price {
            display: flex;
            align-items: baseline;
            gap: 9px;
            flex-wrap: wrap;
            padding-top: 10px;
            border-top: 1px solid var(--rule-soft);
        }

            .book-price .now {
                font-family: 'Playfair Display', Georgia, serif;
                font-size: 1.15rem;
                font-weight: 600;
                color: var(--royal);
                letter-spacing: -.005em;
            }

            .book-price .was {
                font-size: 12.5px;
                color: var(--ink-faint);
                text-decoration: line-through;
                font-family: 'Inter', sans-serif;
            }

            .book-price .off {
                font-family: 'Inter', sans-serif;
                font-size: 9.5px;
                font-weight: 600;
                color: var(--royal);
                background: var(--royal-soft);
                padding: 3px 8px;
                border-radius: 2px;
                letter-spacing: .16em;
                text-transform: uppercase;
            }

        .book-stars {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-family: 'Inter', sans-serif;
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--brass-deep);
            margin-bottom: 4px;
        }

            .book-stars i {
                color: var(--royal);
                font-size: 10px;
            }

            .book-stars span {
                color: var(--ink-faint);
                margin-left: 2px;
                letter-spacing: .14em;
            }

        /* ==================================================
                                   CATEGORY STRIP
                                ================================================== */
        .cat-strip {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 18px;
        }

        .cat-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 32px 20px;
            background: var(--paper-2);
            border: 1px solid var(--rule);
            border-radius: 3px;
            text-decoration: none;
            color: var(--ink);
            transition: all .25s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 1px 0 rgba(255,255,255,.7) inset;
            transform: translateZ(0);
        }

            .cat-card::after {
                content: '';
                position: absolute;
                inset: 6px;
                border: 1px solid transparent;
                border-radius: 1px;
                transition: border-color .25s ease;
                pointer-events: none;
            }

            .cat-card:hover::after {
                border-color: rgba(76,29,149,.35);
            }

            .cat-card:hover {
                border-color: var(--royal);
                transform: translateY(-4px);
                box-shadow: 0 16px 32px -18px rgba(76,29,149,.4);
            }

            .cat-card i,
            .cat-card strong,
            .cat-card span {
                position: relative;
                z-index: 1;
            }

            .cat-card i {
                font-size: 20px;
                color: var(--royal);
            }

            .cat-card strong {
                font-family: 'Playfair Display', serif;
                font-size: 14px;
                font-weight: 600;
                letter-spacing: .01em;
            }

            .cat-card span {
                font-family: 'Inter', sans-serif;
                font-size: 10.5px;
                color: var(--ink-faint);
                letter-spacing: .22em;
                text-transform: uppercase;
            }

        /* ==================================================
                                   BANNER
                                ================================================== */
        .banner {
            position: relative;
            border-radius: 4px;
            overflow: hidden;
            padding: 60px 56px;
            background: linear-gradient(120deg, var(--poster-2) 0%, var(--poster) 55%, var(--poster-2) 100%);
            color: var(--ink);
            display: grid;
            grid-template-columns: 1.3fr auto;
            gap: 32px;
            align-items: center;
            margin-bottom: 0;
            box-shadow: 0 32px 64px -32px rgba(20,14,30,.35), 0 8px 20px -10px rgba(20,14,30,.20), 0 0 0 1px rgba(122,98,48,.38) inset, inset 0 0 100px rgba(76,29,149,.05);
            transform: translateZ(0);
        }

            .banner::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse at center, transparent 50%, rgba(46,16,101,.08) 100%);
                pointer-events: none;
            }

            .banner::after {
                content: '';
                position: absolute;
                inset: 14px;
                border: 1px solid rgba(122,98,48,.35);
                border-radius: 2px;
                pointer-events: none;
            }

        .banner-copy {
            position: relative;
            z-index: 2;
        }

            .banner-copy .kicker {
                font-family: 'Inter', sans-serif;
                font-size: 10px;
                letter-spacing: .48em;
                text-transform: uppercase;
                color: var(--brass-deep);
                margin-bottom: 14px;
                font-weight: 500;
            }

            .banner-copy h3 {
                font-family: 'Playfair Display', Georgia, serif;
                font-size: 1.95rem;
                font-weight: 500;
                margin: 0 0 16px;
                line-height: 1.2;
                color: var(--ink);
                letter-spacing: -.01em;
            }

            .banner-copy p {
                margin: 0;
                color: var(--ink-soft);
                font-size: 15px;
                max-width: 56ch;
                line-height: 1.7;
                font-weight: 400;
            }
    </style>
}

<div class="home">

    <!-- ==================================================
         HERO
    ================================================== -->
    <section class="hero" aria-label="Featured">
        <div class="hero-copy">
            <span class="hero-badge">
                <i class="fa-solid fa-star" aria-hidden="true"></i>
                Est. MMXXV · Independent
            </span>
            <h1>
                Where every <br />
                <em>sentence</em> <br/>leaves a mark.
            </h1>
            <p>
                A small, considered collection of fiction, non fictions.
            </p>
            <div class="hero-actions">
                <a asp-action="Index" asp-route-sortOrder="" class="btn-primary-hero">
                    <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                    Browse Catalogue
                </a>
                <a asp-action="Index" asp-route-sortOrder="bestseller" class="btn-ghost-hero">
                    See Bestsellers
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
            @if (heroBooks.Any())
            {
                <div class="hero-stack">
                    @foreach (var hb in heroBooks)
                    {
                        <div class="hero-book">
                            <img src="@hb.ImageUrl"
                                 alt=""
                                 loading="eager"
                                 decoding="async"
                                 onerror="this.onerror=null;this.src='/images/placeholder-book.png';" />
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- ==================================================
         TRUST STRIP
    ================================================== -->
    <section class="trust" aria-label="Store benefits">
        <div class="trust-item">
            <div class="trust-icon"><i class="fa-solid fa-truck-fast"></i></div>
            <div class="trust-text">
                <strong>Free delivery</strong>
                <span>On orders over ₹500</span>
            </div>
        </div>
        <div class="trust-item">
            <div class="trust-icon"><i class="fa-solid fa-rotate-left"></i></div>
            <div class="trust-text">
                <strong>Easy returns</strong>
                <span>30-day return window</span>
            </div>
        </div>
        <div class="trust-item">
            <div class="trust-icon"><i class="fa-solid fa-shield-halved"></i></div>
            <div class="trust-text">
                <strong>Secure checkout</strong>
                <span>Encrypted payments</span>
            </div>
        </div>
        <div class="trust-item">
            <div class="trust-icon"><i class="fa-solid fa-headset"></i></div>
            <div class="trust-text">
                <strong>Reader support</strong>
                <span>Real humans, real advice</span>
            </div>
        </div>
    </section>

    <!-- ==================================================
         CATALOGUE (DataTable — JS unchanged)
    ================================================== -->
    <section class="section" aria-label="Catalogue">
        <div class="section-head">
            <div>
                <div class="kicker">@(isBestseller ? "This Month" : "Full Catalogue")</div>
                <h2>
                    @if (isBestseller)
                    {
                        <text>What everyone's <em>reading</em></text>
                    }
                    else
                    {
                        <text>All <em>books</em></text>
                    }
                </h2>
            </div>
            <div style="display:flex; gap:10px; align-items:center;">
                <a asp-action="Index" asp-route-sortOrder=""
                   class="more" style="@(string.IsNullOrEmpty(currentSort) ? "color:var(--royal);" : "")">
                    All Books
                </a>
                <span style="color:var(--rule);">·</span>
                <a asp-action="Index" asp-route-sortOrder="bestseller"
                   class="more" style="@(isBestseller ? "color:var(--royal);" : "")">
                    Bestsellers
                </a>
            </div>
        </div>

        @if (!products.Any())
        {
            <div role="status" style="text-align:center; padding:60px 20px; color:var(--ink-soft);">
                <h2 style="font-family:'Playfair Display',serif; font-weight:500; color:var(--ink); font-size:1.6rem;">
                    Nothing on the shelf yet
                </h2>
                <p style="font-family:'Cormorant Garamond',serif; font-style:italic; font-size:1.05rem; margin-top:8px;">
                    New titles are added regularly — do check back.
                </p>
            </div>
        }
        else
        {
            <table id="tblData" class="w-100">
                <thead>
                    <tr><th>A-Z</th></tr>
                </thead>
                <tbody>
                    @foreach (var product in products)
                    {
                        var soldCount = 0;
                        if (isBestseller && bestsellerQuantities != null)
                        {
                            bestsellerQuantities.TryGetValue(product.Id, out soldCount);
                        }
                        var hasDiscount = product.ListPrice > product.Price;
                        var discountPct = hasDiscount
                            ? (int)Math.Round((1 - product.Price / product.ListPrice) * 100)
                            : 0;

                        <tr data-title="@product.Title" data-author="@product.Author">
                            <td>
                                <a class="book"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   aria-label="View @product.Title by @product.Author">

                                    <div class="cover-wrap">
                                        @if (isBestseller && soldCount > 0)
                                        {
                                            <span class="tag best">Bestseller</span>
                                        }
                                        else if (hasDiscount)
                                        {
                                            <span class="tag sale">−@discountPct%</span>
                                        }

                                        <div class="cover">
                                            <img src="@product.ImageUrl"
                                                 alt="Cover of @product.Title by @product.Author"
                                                 loading="lazy"
                                                 decoding="async"
                                                 onerror="this.onerror=null;this.src='/images/placeholder-book.png';" />
                                        </div>
                                    </div>

                                    <div class="meta">
                                        <h3 class="book-title">@product.Title</h3>
                                        <div class="book-author">@product.Author</div>

                                        @if (isBestseller && soldCount > 0)
                                        {
                                            <div class="book-stars" aria-label="Popular">
                                                <i class="fa-solid fa-fire"></i>
                                                <span>@soldCount sold</span>
                                            </div>
                                        }

                                        <div class="book-price">
                                            <span class="now">₹@product.Price.ToString("N2")</span>
                                            @if (hasDiscount)
                                            {
                                                <span class="was">₹@product.ListPrice.ToString("N2")</span>
                                                <span class="off">@discountPct% off</span>
                                            }
                                        </div>
                                    </div>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <!-- ==================================================
         CATEGORY STRIP
    ================================================== -->
    <section class="section" aria-label="Browse by section">
        <div class="section-head">
            <div>
                <div class="kicker">Explore</div>
                <h2>Browse by <em>section</em></h2>
            </div>
        </div>

        <div class="cat-strip">
            <a class="cat-card" asp-action="Index" asp-route-sortOrder="">
                <i class="fa-solid fa-book" aria-hidden="true"></i>
                <strong>Fiction</strong>
                <span>Novels & stories</span>
            </a>
            <a class="cat-card" asp-action="Index" asp-route-sortOrder="">
                <i class="fa-solid fa-feather-pointed" aria-hidden="true"></i>
                <strong>Poetry</strong>
                <span>Verse & rhyme</span>
            </a>
            <a class="cat-card" asp-action="Index" asp-route-sortOrder="">
                <i class="fa-solid fa-scroll" aria-hidden="true"></i>
                <strong>Essays</strong>
                <span>Ideas & arguments</span>
            </a>
            <a class="cat-card" asp-action="Index" asp-route-sortOrder="bestseller">
                <i class="fa-solid fa-fire" aria-hidden="true"></i>
                <strong>Bestsellers</strong>
                <span>Reader favourites</span>
            </a>
            <a class="cat-card" asp-action="Index" asp-route-sortOrder="">
                <i class="fa-solid fa-gift" aria-hidden="true"></i>
                <strong>Gift Sets</strong>
                <span>Boxed & bound</span>
            </a>
        </div>
    </section>

    <!-- ==================================================
         MID-PAGE BANNER
    ================================================== -->
    <section class="banner" aria-label="Promotion">
        <div class="banner-copy">
            <div class="kicker">Members Only</div>
            <h3>Join The Reading Room.<br />Get 10% off your first order.</h3>
            <p>
                Members get early access to new titles, seasonal reading lists,
                and a personal recommendation each month. No spam — just books.
            </p>
        </div>
        <div>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn-primary-hero">
                <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                Create account
            </a>
        </div>
    </section>

</div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}