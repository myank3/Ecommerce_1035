

<div class="container">
    <div>
        <h2 class="text-center text-info">Company List</h2>
    </div>
    <div>
        <div class="col-2text-end mb-3">
            <a asp-action="Upsert" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Company
            </a>
        </div>
        <table id="tblData" class="table table-bordered table-striped" style="width:100%">
            <thead>
                <tr>
                    <th>Company Name</th>
                    <th>Street Address</th>
                    <th>City</th>
                    <th>State</th>
                    <th>Postal Code</th>
                    <th>Is Authorized</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
@section Scripts
{
    <script src="~/js/company.js"></script>
}