<div class="container mt-3">
    <div class="card shadow border-0">

        <div class="card-header bg-primary bg-gradient py-2">
            <h4 class="text-dark text-center m-0">Order Management</h4>
        </div>

        <div class="card-body p-3">

            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-4">
                    <label class="form-label small mb-1">From Date</label>
                    <input type="date" id="fromDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1">To Date</label>
                    <input type="date" id="toDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <button type="button" id="searchBtn" class="btn btn-primary btn-sm w-100">
                        <i class="fas fa-search"></i> Search
                    </button>
                </div>
            </div>

            <table id="tblData" class="table table-sm table-hover table-bordered w-100">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Amount</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/order.js"></script>
}