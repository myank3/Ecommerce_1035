@model IEnumerable<Ecommerce_1035.Models.Models.Product>
@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "Book Store — fine books, carefully chosen. Fiction, essays, poetry, and bestsellers.";

    var currentSort = ViewBag.CurrentSort as string;
    var bestsellerQuantities = ViewBag.BestsellerQuantities as Dictionary<int, int>;
    var isBestseller = currentSort == "bestseller";
    var products = Model?.ToList() ?? new List<Ecommerce_1035.Models.Models.Product>();

    // Hero picks — 3 books used as visual
    var heroBooks = products.Take(3).ToList();
}

@section Head {
    <style>
        .home {
            --paper: #f7f4ee;
            --paper-2: #ece4d3;
            --paper-3: #d9cdb2;
            --ink: #14110d;
            --ink-soft: #5c5449;
            --rule: #cfc4ac;
            --rule-dark: #9c8a68;
            --gold: #8a6c34;
            --accent: #6b2a2a;
            --brand-1: #6c2bd9;
            --brand-2: #8b3dff;
            --brand-3: #4c1d95;
            --brand-soft: #f3f0fb;
        }

        /* ==================================================
                           HERO
                        ================================================== */
        .hero {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            /* RICHER GRADIENT — deep midnight → royal purple → warm magenta */
            background: radial-gradient(circle at 12% 15%, rgba(253,230,138,.22) 0%, transparent 40%), radial-gradient(circle at 88% 85%, rgba(236,72,153,.28) 0%, transparent 45%), linear-gradient(120deg, #1a0b3d 0%, #4c1d95 40%, #6c2bd9 70%, #a21caf 100%);
            color: #fff;
            margin-bottom: 44px;
            min-height: 400px;
            display: grid;
            grid-template-columns: 1.1fr 1fr;
        }

            .hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: radial-gradient(circle at 85% 20%, rgba(255,255,255,.14) 0%, transparent 45%), radial-gradient(circle at 15% 90%, rgba(253,230,138,.18) 0%, transparent 40%);
                pointer-events: none;
            }

        .hero-copy {
            padding: 56px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            z-index: 2;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            align-self: flex-start;
            background: rgba(255,255,255,.15);
            border: 1px solid rgba(255,255,255,.28);
            color: #fde68a;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .22em;
            text-transform: uppercase;
            padding: 6px 14px;
            border-radius: 999px;
            margin-bottom: 22px;
        }

        .hero h1 {
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-size: 3rem;
            font-weight: 700;
            line-height: 1.08;
            margin: 0 0 18px;
            letter-spacing: -.01em;
        }

            .hero h1 em {
                font-style: italic;
                color: #fde68a;
                font-weight: 500;
            }

        .hero p {
            font-size: 16px;
            line-height: 1.6;
            color: rgba(255,255,255,.85);
            max-width: 44ch;
            margin: 0 0 30px;
        }

        .hero-actions {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn-primary-hero,
        .btn-ghost-hero {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: .04em;
            padding: 14px 26px;
            border-radius: 10px;
            text-decoration: none;
            transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
        }

        .btn-primary-hero {
            background: #fde68a;
            color: #4c1d95;
            box-shadow: 0 8px 20px -8px rgba(253,230,138,.7);
        }

            .btn-primary-hero:hover {
                background: #fcd34d;
                color: #4c1d95;
                transform: translateY(-2px);
                box-shadow: 0 12px 24px -8px rgba(253,230,138,.85);
            }

        .btn-ghost-hero {
            background: rgba(255,255,255,.12);
            color: #fff;
            border: 1px solid rgba(255,255,255,.35);
        }

            .btn-ghost-hero:hover {
                background: rgba(255,255,255,.22);
                color: #fff;
                transform: translateY(-2px);
            }

        /* Hero visual — real covers */
        .hero-visual {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        .hero-stack {
            position: relative;
            width: 100%;
            max-width: 340px;
            height: 320px;
        }

        .hero-book {
            position: absolute;
            width: 150px;
            height: 220px;
            border-radius: 4px;
            overflow: hidden;
            box-shadow: 0 30px 50px -20px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.08) inset;
            background: var(--paper-2);
        }

            .hero-book img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            .hero-book::after {
                /* spine shadow */
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 8px;
                background: linear-gradient(to right, rgba(0,0,0,.45), transparent);
                pointer-events: none;
            }

            .hero-book:nth-child(1) {
                transform: rotate(-8deg) translate(-40px, 14px);
                z-index: 1;
            }

            .hero-book:nth-child(2) {
                transform: rotate(2deg) translate(10px, -12px);
                z-index: 3;
            }

            .hero-book:nth-child(3) {
                transform: rotate(9deg) translate(70px, 22px);
                z-index: 2;
            }
                /* fallback if fewer than 3 books */
                .hero-book:nth-child(1):only-child,
                .hero-book:nth-child(2):nth-last-child(1),
                .hero-book:nth-child(3):nth-last-child(1) {
                    transform: rotate(0);
                    left: 50%;
                    margin-left: -75px;
                }

            .hero-book:nth-child(2):nth-last-child(2) {
                transform: rotate(-6deg) translate(-30px, 0);
            }

            .hero-book:nth-child(3):nth-last-child(2) {
                transform: rotate(6deg) translate(30px, 0);
            }

        /* ==================================================
                           TRUST STRIP
                        ================================================== */
        .trust {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            background: #fff;
            border: 1px solid var(--rule);
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 56px;
        }

        .trust-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 20px 24px;
            border-right: 1px solid var(--rule);
        }

            .trust-item:last-child {
                border-right: none;
            }

        .trust-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--brand-soft);
            color: var(--brand-1);
            display: grid;
            place-items: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .trust-text strong {
            display: block;
            font-size: 13px;
            color: var(--ink);
            font-weight: 600;
        }

        .trust-text span {
            font-size: 12px;
            color: var(--ink-soft);
        }

        /* ==================================================
                           SECTION HEAD
                        ================================================== */
        .section {
            margin-bottom: 60px;
        }

        .section-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 26px;
            flex-wrap: wrap;
        }

            .section-head .kicker {
                font-family: 'Inter', sans-serif;
                font-size: 10px;
                letter-spacing: .45em;
                text-transform: uppercase;
                color: var(--gold);
                margin-bottom: 6px;
            }

            .section-head h2 {
                font-family: 'Cormorant Garamond', Georgia, serif;
                font-size: 1.9rem;
                font-weight: 500;
                font-style: italic;
                margin: 0;
                color: var(--ink);
                line-height: 1.1;
            }

                .section-head h2 em {
                    color: var(--accent);
                }

            .section-head .more {
                font-family: 'Inter', sans-serif;
                font-size: 12px;
                font-weight: 600;
                letter-spacing: .14em;
                text-transform: uppercase;
                color: var(--brand-1);
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: gap .2s ease;
            }

                .section-head .more:hover {
                    gap: 10px;
                    color: var(--brand-2);
                }

        /* ==================================================
                           DATATABLE PRODUCT GRID
                        ================================================== */
        #tblData_wrapper {
            margin-top: 6px;
        }

            /* push DataTables controls to look like a filter bar */
            #tblData_wrapper .dataTables_length,
            #tblData_wrapper .dataTables_filter {
                font-family: 'Inter', sans-serif;
                font-size: 12px;
                color: var(--ink-soft);
                margin: 0 0 18px;
            }

            #tblData_wrapper .dataTables_filter {
                float: right;
            }

            #tblData_wrapper .dataTables_length {
                float: left;
            }

                #tblData_wrapper .dataTables_length select,
                #tblData_wrapper .dataTables_filter input {
                    border: 1px solid var(--rule-dark);
                    background: #fff;
                    border-radius: 8px;
                    padding: 8px 12px;
                    font-family: inherit;
                    font-size: 13px;
                    color: var(--ink);
                    margin-left: 6px;
                }

            #tblData_wrapper .dataTables_filter input {
                min-width: 220px;
                font-style: normal;
            }

                #tblData_wrapper .dataTables_length select:focus,
                #tblData_wrapper .dataTables_filter input:focus {
                    outline: none;
                    border-color: var(--brand-1);
                    box-shadow: 0 0 0 3px rgba(108,43,217,.15);
                }

            #tblData_wrapper .dataTables_info,
            #tblData_wrapper .dataTables_paginate {
                font-family: 'Inter', sans-serif;
                font-size: 12px;
                color: var(--ink-soft);
                margin: 18px 0 0;
            }

                #tblData_wrapper .dataTables_paginate .paginate_button {
                    font-family: inherit !important;
                    font-size: 13px !important;
                    color: var(--ink-soft) !important;
                    padding: 6px 12px !important;
                    border-radius: 8px !important;
                    border: 1px solid transparent !important;
                    background: transparent !important;
                    margin: 0 2px !important;
                }

                    #tblData_wrapper .dataTables_paginate .paginate_button:hover {
                        background: var(--brand-soft) !important;
                        border-color: var(--brand-soft) !important;
                        color: var(--brand-1) !important;
                    }

                    #tblData_wrapper .dataTables_paginate .paginate_button.current {
                        background: var(--brand-1) !important;
                        border-color: var(--brand-1) !important;
                        color: #fff !important;
                        font-weight: 700 !important;
                    }

                    #tblData_wrapper .dataTables_paginate .paginate_button.disabled {
                        opacity: .35;
                    }

        /* ---------- The table -> grid trick ---------- */
        #tblData {
            border-collapse: separate;
            border-spacing: 0;
            margin: 0;
            display: block;
            width: 100%;
            background: transparent;
        }

            #tblData > thead {
                display: none;
            }

            /* 4 BOOKS PER ROW — explicit 4 columns on desktop */
            #tblData > tbody {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 26px 22px;
            }

                #tblData > tbody > tr {
                    display: contents;
                }

                    #tblData > tbody > tr > td {
                        display: block;
                        border: none;
                        padding: 0;
                    }

        /* ---------- Book card ---------- */
        .book {
            display: flex;
            flex-direction: column;
            text-decoration: none;
            color: var(--ink);
            border-radius: 10px;
            transition: transform .25s ease;
            height: 100%;
        }

            .book:hover {
                transform: translateY(-4px);
            }

            .book .cover-wrap {
                position: relative;
                border-radius: 8px;
                overflow: hidden;
                background: var(--paper-2);
                box-shadow: 0 4px 14px -6px rgba(20,17,13,.25);
                transition: box-shadow .3s ease;
            }

            .book:hover .cover-wrap {
                box-shadow: 0 14px 28px -12px rgba(20,17,13,.4);
            }

            .book .cover {
                aspect-ratio: 2 / 3;
                overflow: hidden;
                position: relative;
            }

                .book .cover img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                    transition: transform .5s ease;
                }

            .book:hover .cover img {
                transform: scale(1.05);
            }

            .book .tag {
                position: absolute;
                top: 10px;
                left: 10px;
                z-index: 3;
                font-family: 'Inter', sans-serif;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: .14em;
                text-transform: uppercase;
                padding: 5px 9px;
                border-radius: 4px;
                background: var(--ink);
                color: #fff;
            }

                .book .tag.sale {
                    background: #dc2626;
                }

                .book .tag.best {
                    background: var(--brand-1);
                }

            .book .meta {
                padding: 14px 4px 0;
            }

        .book-title {
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-size: 1.05rem;
            font-weight: 600;
            line-height: 1.25;
            margin: 0 0 4px;
            color: var(--ink);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 42px;
            transition: color .2s;
        }

        .book:hover .book-title {
            color: var(--brand-1);
        }

        .book-author {
            font-size: 12.5px;
            color: var(--ink-soft);
            margin-bottom: 10px;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .book-price {
            display: flex;
            align-items: baseline;
            gap: 8px;
            flex-wrap: wrap;
        }

            .book-price .now {
                font-family: 'Cormorant Garamond', Georgia, serif;
                font-size: 1.15rem;
                font-weight: 700;
                color: var(--ink);
            }

            .book-price .was {
                font-size: 12px;
                color: var(--ink-soft);
                text-decoration: line-through;
            }

            .book-price .off {
                font-size: 11px;
                font-weight: 600;
                color: #dc2626;
                background: #fee2e2;
                padding: 2px 7px;
                border-radius: 4px;
            }

        .book-stars {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 12px;
            color: var(--gold);
            margin-bottom: 6px;
        }

            .book-stars span {
                color: var(--ink-soft);
                margin-left: 4px;
            }

        /* ==================================================
                           CATEGORY STRIP
                        ================================================== */
        .cat-strip {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 16px;
        }

        .cat-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 26px 18px;
            background: #fff;
            border: 1px solid var(--rule);
            border-radius: 12px;
            text-decoration: none;
            color: var(--ink);
            transition: all .2s ease;
        }

            .cat-card:hover {
                border-color: var(--brand-1);
                transform: translateY(-3px);
                box-shadow: 0 10px 24px -12px rgba(108,43,217,.35);
                color: var(--brand-1);
            }

            .cat-card i {
                font-size: 22px;
                color: var(--brand-1);
            }

            .cat-card strong {
                font-size: 13px;
                font-weight: 600;
            }

            .cat-card span {
                font-size: 11px;
                color: var(--ink-soft);
                letter-spacing: .04em;
            }

        /* ==================================================
                           BANNER
                        ================================================== */
        .banner {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            padding: 52px 48px;
            /* RICHER GRADIENT — matches the hero treatment */
            background: radial-gradient(circle at 90% 50%, rgba(253,230,138,.28) 0%, transparent 45%), radial-gradient(circle at 10% 50%, rgba(168,85,247,.35) 0%, transparent 50%), linear-gradient(120deg, #1a0b3d 0%, #2d1a4a 50%, #4c1d95 100%);
            color: #fff;
            display: grid;
            grid-template-columns: 1.3fr auto;
            gap: 24px;
            align-items: center;
            margin-bottom: 0;
        }

            .banner::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: radial-gradient(circle at 90% 50%, rgba(253,230,138,.22) 0%, transparent 40%);
                pointer-events: none;
            }

        .banner-copy {
            position: relative;
            z-index: 2;
        }

            .banner-copy .kicker {
                font-family: 'Inter', sans-serif;
                font-size: 10px;
                letter-spacing: .45em;
                text-transform: uppercase;
                color: #fde68a;
                margin-bottom: 10px;
            }

            .banner-copy h3 {
                font-family: 'Cormorant Garamond', Georgia, serif;
                font-size: 1.8rem;
                font-weight: 600;
                font-style: italic;
                margin: 0 0 12px;
                line-height: 1.15;
            }

            .banner-copy p {
                margin: 0;
                color: rgba(255,255,255,.82);
                font-size: 15px;
                max-width: 52ch;
            }

        /* ==================================================
                           RESPONSIVE
                        ================================================== */
        @@media (max-width: 1200px) {
            #tblData > tbody {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media (max-width: 992px) {
            .hero {
                grid-template-columns: 1fr;
                min-height: auto;
            }

            .hero-visual {
                display: none;
            }

            .hero-copy {
                padding: 44px 36px;
            }

            .hero h1 {
                font-size: 2.2rem;
            }

            .trust {
                grid-template-columns: 1fr 1fr;
            }

            .trust-item:nth-child(2) {
                border-right: none;
            }

            .trust-item:nth-child(1),
            .trust-item:nth-child(2) {
                border-bottom: 1px solid var(--rule);
            }

            .banner {
                grid-template-columns: 1fr;
                padding: 36px 32px;
            }

            #tblData_wrapper .dataTables_filter,
            #tblData_wrapper .dataTables_length {
                float: none;
                display: block;
                margin-bottom: 12px;
            }

                #tblData_wrapper .dataTables_filter input {
                    width: 100%;
                    margin-left: 0;
                }
        }

        @@media (max-width: 640px) {
            .hero-copy {
                padding: 36px 26px;
            }

            .hero h1 {
                font-size: 1.8rem;
            }

            #tblData > tbody {
                grid-template-columns: repeat(2, 1fr);
                gap: 18px 12px;
            }

            .book-title {
                font-size: .95rem;
                min-height: 36px;
            }

            .book-price .now {
                font-size: 1rem;
            }

            .trust {
                grid-template-columns: 1fr;
            }

            .trust-item {
                border-right: none;
                border-bottom: 1px solid var(--rule);
            }

                .trust-item:last-child {
                    border-bottom: none;
                }

            .section {
                margin-bottom: 44px;
            }
        }
    </style>
}

<div class="home">

    <!-- ==================================================
         HERO — with real book covers
    ================================================== -->
    <section class="hero" aria-label="Featured">
        <div class="hero-copy">
            <span class="hero-badge">
                <i class="fa-solid fa-star" aria-hidden="true"></i>
                Est. MMXXV · Independent
            </span>
            <h1>
                Books worth<br />
                <em>lingering</em> over.
            </h1>
            <p>
                A small, considered collection of fiction, essays, and poetry —
                chosen for readers who appreciate fine prose and careful attention.
            </p>
            <div class="hero-actions">
                <a asp-action="Index" asp-route-sortOrder="" class="btn-primary-hero">
                    <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                    Browse Catalogue
                </a>
                <a asp-action="Index" asp-route-sortOrder="bestseller" class="btn-ghost-hero">
                    See Bestsellers
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
            @if (heroBooks.Any())
            {
                <div class="hero-stack">
                    @foreach (var hb in heroBooks)
                    {
                        <div class="hero-book">
                            <img src="@hb.ImageUrl"
                                 alt=""
                                 loading="eager"
                                 decoding="async"
                                 onerror="this.onerror=null;this.src='/images/placeholder-book.png';" />
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- ==================================================
         TRUST STRIP
    ================================================== -->
    <section class="trust" aria-label="Store benefits">
        <div class="trust-item">
            <div class="trust-icon"><i class="fa-solid fa-truck-fast"></i></div>
            <div class="trust-text">
                <strong>Free delivery</strong>
                <span>On orders over ₹500</span>
            </div>
        </div>
        <div class="trust-item">
            <div class="trust-icon"><i class="fa-solid fa-rotate-left"></i></div>
            <div class="trust-text">
                <strong>Easy returns</strong>
                <span>30-day return window</span>
            </div>
        </div>
        <div class="trust-item">
            <div class="trust-icon"><i class="fa-solid fa-shield-halved"></i></div>
            <div class="trust-text">
                <strong>Secure checkout</strong>
                <span>Encrypted payments</span>
            </div>
        </div>
        <div class="trust-item">
            <div class="trust-icon"><i class="fa-solid fa-headset"></i></div>
            <div class="trust-text">
                <strong>Reader support</strong>
                <span>Real humans, real advice</span>
            </div>
        </div>
    </section>

    <!-- ==================================================
         CATALOGUE (DataTable)
    ================================================== -->
    <section class="section" aria-label="Catalogue">
        <div class="section-head">
            <div>
                <div class="kicker">@(isBestseller ? "This Month" : "Full Catalogue")</div>
                <h2>
                    @if (isBestseller)
                    {
                        <text>What everyone's <em>reading</em></text>
                    }
                    else
                    {
                        <text>All <em>books</em></text>
                    }
                </h2>
            </div>
            <div style="display:flex; gap:8px;">
                <a asp-action="Index" asp-route-sortOrder=""
                   class="more" style="@(string.IsNullOrEmpty(currentSort) ? "color:var(--brand-1);" : "")">
                    All Books
                </a>
                <span style="color:var(--rule);">|</span>
                <a asp-action="Index" asp-route-sortOrder="bestseller"
                   class="more" style="@(isBestseller ? "color:var(--brand-1);" : "")">
                    Bestsellers
                </a>
            </div>
        </div>

        @if (!products.Any())
        {
            <div role="status" style="text-align:center; padding:60px 20px; color:var(--ink-soft);">
                <h2 style="font-family:'Cormorant Garamond',serif; font-style:italic; font-weight:500; color:var(--ink);">
                    Nothing on the shelf yet
                </h2>
                <p>New titles are added regularly — do check back.</p>
            </div>
        }
        else
        {
            <table id="tblData" class="w-100">
                <thead>
                    <tr><th>A-Z</th></tr>
                </thead>
                <tbody>
                    @foreach (var product in products)
                    {
                        var soldCount = 0;
                        if (isBestseller && bestsellerQuantities != null)
                        {
                            bestsellerQuantities.TryGetValue(product.Id, out soldCount);
                        }
                        var hasDiscount = product.ListPrice > product.Price;
                        var discountPct = hasDiscount
                            ? (int)Math.Round((1 - product.Price / product.ListPrice) * 100)
                            : 0;

                        <tr data-title="@product.Title" data-author="@product.Author">
                            <td>
                                <a class="book"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   aria-label="View @product.Title by @product.Author">

                                    <div class="cover-wrap">
                                        @if (isBestseller && soldCount > 0)
                                        {
                                            <span class="tag best">Bestseller</span>
                                        }
                                        else if (hasDiscount)
                                        {
                                            <span class="tag sale">−@discountPct%</span>
                                        }

                                        <div class="cover">
                                            <img src="@product.ImageUrl"
                                                 alt="Cover of @product.Title by @product.Author"
                                                 loading="lazy"
                                                 decoding="async"
                                                 onerror="this.onerror=null;this.src='/images/placeholder-book.png';" />
                                        </div>
                                    </div>

                                    <div class="meta">
                                        <h3 class="book-title">@product.Title</h3>
                                        <div class="book-author">@product.Author</div>

                                        @if (isBestseller && soldCount > 0)
                                        {
                                            <div class="book-stars" aria-label="Popular">
                                                <i class="fa-solid fa-fire"></i>
                                                <span>@soldCount sold</span>
                                            </div>
                                        }

                                        <div class="book-price">
                                            <span class="now">₹@product.Price.ToString("N2")</span>
                                            @if (hasDiscount)
                                            {
                                                <span class="was">₹@product.ListPrice.ToString("N2")</span>
                                                <span class="off">@discountPct% off</span>
                                            }
                                        </div>
                                    </div>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <!-- ==================================================
         CATEGORY STRIP
    ================================================== -->
    <section class="section" aria-label="Browse by section">
        <div class="section-head">
            <div>
                <div class="kicker">Explore</div>
                <h2>Browse by <em>section</em></h2>
            </div>
        </div>

        <div class="cat-strip">
            <a class="cat-card" asp-action="Index" asp-route-sortOrder="">
                <i class="fa-solid fa-book" aria-hidden="true"></i>
                <strong>Fiction</strong>
                <span>Novels & stories</span>
            </a>
            <a class="cat-card" asp-action="Index" asp-route-sortOrder="">
                <i class="fa-solid fa-feather-pointed" aria-hidden="true"></i>
                <strong>Poetry</strong>
                <span>Verse & rhyme</span>
            </a>
            <a class="cat-card" asp-action="Index" asp-route-sortOrder="">
                <i class="fa-solid fa-scroll" aria-hidden="true"></i>
                <strong>Essays</strong>
                <span>Ideas & arguments</span>
            </a>
            <a class="cat-card" asp-action="Index" asp-route-sortOrder="bestseller">
                <i class="fa-solid fa-fire" aria-hidden="true"></i>
                <strong>Bestsellers</strong>
                <span>Reader favourites</span>
            </a>
            <a class="cat-card" asp-action="Index" asp-route-sortOrder="">
                <i class="fa-solid fa-gift" aria-hidden="true"></i>
                <strong>Gift Sets</strong>
                <span>Boxed & bound</span>
            </a>
        </div>
    </section>

    <!-- ==================================================
         MID-PAGE BANNER
    ================================================== -->
    <section class="banner" aria-label="Promotion">
        <div class="banner-copy">
            <div class="kicker">Members Only</div>
            <h3>Join The Reading Room.<br />Get 10% off your first order.</h3>
            <p>
                Members get early access to new titles, seasonal reading lists,
                and a personal recommendation each month. No spam — just books.
            </p>
        </div>
        <div>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn-primary-hero">
                <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                Create account
            </a>
        </div>
    </section>

</div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}