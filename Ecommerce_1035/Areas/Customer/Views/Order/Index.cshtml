@model IEnumerable<Ecommerce_1035.Models.Models.OrderHeader>
@{
    ViewData["Title"] = "My Orders";
}

<div class="container my-4">
    <h1 class="mb-4">My Orders</h1>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <h3>No orders yet</h3>
            <p>Once you place an order, it will appear here.</p>
            <a asp-area="Customer" asp-controller="Home" asp-action="Index"
               class="btn btn-primary mt-2">Browse Books</a>
        </div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.OrderDate.ToString("MMM d, yyyy")</td>
                        <td>@order.OrderStatus</td>
                        <td>@order.PaymentStatus</td>
                        <td class="text-end">@order.OrderTotal.ToString("C")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@order.Id"
                               class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>