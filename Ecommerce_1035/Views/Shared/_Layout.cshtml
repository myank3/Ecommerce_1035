    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />

    <!-- Google Search Snippet, Android & Apple Touch Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="~/logo.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/logo.png" asp-append-version="true" />

    <!-- Open Graph Metadata (WhatsApp, LinkedIn, Twitter/X previews) -->
    <meta property="og:title" content="@(ViewData["Title"] ?? "Book Store") · Bookshelf" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Book Store — fine books, carefully chosen.")" />
    <meta property="og:image" content="https://bookshelff.runasp.net/logo.png" />
    <meta property="og:url" content="https://bookshelff.runasp.net" />
    <meta property="og:type" content="website" />

   
    </script>

    <link rel="preconnect" href="https://cdn.datatables.net" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.16/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/1.1.3/sweetalert.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ecommerce_1035.styles.css" asp-append-version="true" />
    <style>
        :root {
            /* ===== PALETTE ===== */
            --ink:            #1e1a24;
            --ink-soft:       #4c4658;
            --ink-faint:      #8a8394;

            --paper:          #f8f6f0;
            --paper-2:        #f2efe7;
            --paper-3:        #eae6db;

            --rule:           #d4cfc0;
            --rule-soft:      #e6e2d6;
            --rule-dark:      #b8a274;

            --brass:          #a88b4a;
            --brass-deep:     #7a6230;
            --brass-light:    #d4b978;

            --poster:         #faf8f2;
            --poster-2:       #f3f0e8;

            --royal:          #4c1d95;
            --royal-mid:      #6c2bd9;
            --royal-deep:     #2e1065;
            --royal-soft:     #ede9fe;

            /* Dark horizon — LIGHTER than before */
            --horizon-1:      #2a2438;
            --horizon-2:      #221d2e;

            /* Legacy aliases */
            --brand-1:        #4c1d95;
            --brand-2:        #6c2bd9;
            --brand-3:        #2e1065;
            --brand-soft:     #ede9fe;

            --gold:           #7a6230;
            --gold-bright:    #d4b978;
            --accent:         #4c1d95;

            --header-h: 68px;
        }

        html { scroll-behavior: smooth; }

        html, body {
            background: var(--paper);
            color: var(--ink);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            font-size: 15px;
            line-height: 1.55;
            min-height: 100%;
            margin: 0;
        }

        /* ================= Skip link ================= */
        .skip-link {
            position: absolute;
            top: -100px;
            left: 12px;
            z-index: 2000;
            background: var(--horizon-1);
            color: #fbf9f4;
            padding: 10px 16px;
            border-radius: 3px;
            font-size: 14px;
            text-decoration: none;
            transition: top .2s ease;
            border: 1px solid var(--brass-deep);
        }
        .skip-link:focus {
            top: 12px;
            color: #fbf9f4;
            outline: 2px solid var(--brass-light);
            outline-offset: 2px;
        }

        :focus-visible {
            outline: 2px solid var(--brass-light);
            outline-offset: 2px;
        }

        /* ================= HEADER — softer horizon, sticky ================= */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 1030;
            background:
                radial-gradient(ellipse at 18% 30%, rgba(168,139,74,.10) 0%, transparent 55%),
                radial-gradient(ellipse at 88% 70%, rgba(76,29,149,.14) 0%, transparent 55%),
                linear-gradient(120deg, var(--horizon-1) 0%, var(--horizon-2) 50%, var(--horizon-1) 100%);
            box-shadow:
                0 4px 18px rgba(20,14,30,.22),
                0 1px 0 rgba(212,185,120,.18) inset,
                0 -1px 0 rgba(212,185,120,.10) inset;
            border-bottom: 1px solid rgba(212,185,120,.22);
            isolation: isolate;
        }

        /* Mountain-ridge silhouette + paper grain overlay */
        .site-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1600' height='40' viewBox='0 0 1600 40' preserveAspectRatio='none'><path d='M0 32 L120 18 L220 28 L340 8 L460 24 L560 14 L680 2 L820 22 L940 10 L1060 26 L1180 14 L1300 30 L1420 16 L1540 26 L1600 20 L1600 40 L0 40 Z' fill='%234c1d95' fill-opacity='0.10'/><path d='M0 36 L160 26 L280 34 L400 18 L520 30 L640 22 L760 10 L880 28 L1000 20 L1120 32 L1240 22 L1360 36 L1480 26 L1600 34 L1600 40 L0 40 Z' fill='%23a88b4a' fill-opacity='0.07'/></svg>"),
                repeating-linear-gradient(90deg,
                    rgba(251,249,244,.012) 0px,
                    rgba(251,249,244,.012) 1px,
                    transparent 1px,
                    transparent 3px);
            background-position: bottom center, top left;
            background-size: 100% 40px, auto;
            background-repeat: no-repeat, repeat;
            pointer-events: none;
            z-index: 0;
        }

        .site-nav {
            position: relative;
            z-index: 1;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 22px;
            min-height: var(--header-h);
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        /* ---------- Brand ---------- */
        .brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 22px;
            font-weight: 600;
            letter-spacing: .01em;
            color: #fbf9f4;
            text-decoration: none;
            padding: 12px 0;
            flex-shrink: 0;
        }
        .brand em {
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-style: italic;
            font-weight: 500;
            color: var(--brass-light);
        }
        .brand .mark {
            width: 36px;
            height: 36px;
            border-radius: 3px;
            background: linear-gradient(180deg, var(--royal-mid) 0%, var(--royal-deep) 100%);
            border: 1px solid rgba(212,185,120,.45);
            display: grid;
            place-items: center;
            font-size: 15px;
            color: var(--brass-light);
            box-shadow:
                0 2px 8px -2px rgba(0,0,0,.45),
                0 1px 0 rgba(255,255,255,.12) inset;
        }
        .brand:hover { color: #fbf9f4; }

        /* ---------- Menu toggle ---------- */
        .nav-toggle {
            display: none;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: transparent;
            border: 1px solid rgba(212,185,120,.45);
            color: var(--brass-light);
            border-radius: 3px;
            font-size: 15px;
            cursor: pointer;
            transition: background .15s ease, border-color .15s ease;
        }
        .nav-toggle:hover {
            background: rgba(212,185,120,.10);
            border-color: var(--brass-light);
        }
        .nav-toggle:focus-visible { outline: 2px solid var(--brass-light); outline-offset: 2px; }

        /* ---------- Nav list ---------- */
        .nav-menu {
            display: flex;
            align-items: center;
            gap: 2px;
            list-style: none;
            margin: 0;
            padding: 0;
            flex: 1;
        }
        .nav-menu > li { position: relative; }

        .nav-menu a,
        .nav-menu button.nav-trigger {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 3px;
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 500;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: rgba(251,249,244,.80);
            text-decoration: none;
            background: transparent;
            border: none;
            cursor: pointer;
            white-space: nowrap;
            transition: background .15s ease, color .15s ease;
        }
        .nav-menu a:hover,
        .nav-menu button.nav-trigger:hover {
            background: rgba(212,185,120,.12);
            color: #fbf9f4;
        }
        .nav-menu a.active {
            background: rgba(212,185,120,.12);
            color: var(--brass-light);
            box-shadow: inset 0 -2px 0 var(--brass-light);
        }

        .caret {
            font-size: 9px;
            opacity: .8;
            transition: transform .2s ease;
        }
        .has-menu.open .caret { transform: rotate(180deg); }

        /* ---------- Dropdown ---------- */
        .submenu {
            list-style: none;
            margin: 0;
            padding: 8px;
            min-width: 240px;
            background: var(--horizon-1);
            border: 1px solid rgba(212,185,120,.35);
            border-radius: 3px;
            box-shadow:
                0 16px 36px -12px rgba(0,0,0,.45),
                0 0 0 1px rgba(255,255,255,.04) inset;
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            transition: opacity .18s ease, transform .18s ease, visibility .18s;
            z-index: 50;
        }
        .has-menu.open .submenu,
        .has-menu:focus-within .submenu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        .submenu a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-radius: 2px;
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 500;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: rgba(251,249,244,.82);
            background: transparent;
            width: 100%;
        }
        .submenu a:hover {
            background: rgba(212,185,120,.12);
            color: var(--brass-light);
        }
        .submenu a i {
            width: 16px;
            text-align: center;
            color: var(--brass-light);
            font-size: 12px;
        }
        .submenu .divider {
            height: 1px;
            background: rgba(212,185,120,.22);
            margin: 6px 8px;
        }

        /* ---------- Cart pill ---------- */
        .cart-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 16px;
            background: linear-gradient(180deg, var(--royal-mid) 0%, var(--royal-deep) 100%);
            border: 1px solid rgba(212,185,120,.45);
            border-radius: 2px;
            color: #fbf9f4;
            text-decoration: none;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .22em;
            text-transform: uppercase;
            margin-left: auto;
            transition: transform .15s ease, box-shadow .15s ease;
            box-shadow:
                0 4px 12px -4px rgba(46,16,101,.55),
                0 1px 0 rgba(255,255,255,.15) inset;
        }
        .cart-link:hover {
            transform: translateY(-1px);
            color: #fbf9f4;
            box-shadow:
                0 8px 20px -6px rgba(46,16,101,.7),
                0 1px 0 rgba(255,255,255,.2) inset;
        }
        .cart-link .count {
            background: var(--brass-light);
            color: var(--royal-deep);
            border-radius: 2px;
            padding: 1px 8px;
            font-size: 11px;
            font-weight: 700;
            min-width: 22px;
            text-align: center;
            line-height: 1.6;
        }

        /* ---------- Login partial wrapper ---------- */
        .login-slot {
            display: flex;
            align-items: center;
        }
        .login-slot > * { margin: 0 !important; }

        .login-slot ul,
        .login-slot .navbar-nav {
            list-style: none;
            margin: 0 !important;
            padding: 0 !important;
            display: flex !important;
            flex-direction: row !important;
            align-items: center;
            gap: 2px;
        }
        .login-slot li {
            display: inline-flex;
            align-items: center;
            margin: 0 !important;
        }
        .login-slot form {
            margin: 0 !important;
            padding: 0 !important;
            display: inline-flex;
        }

        .login-slot a,
        .login-slot button,
        .login-slot .nav-link,
        .login-slot .btn-link {
            display: inline-flex !important;
            align-items: center;
            color: rgba(251,249,244,.80) !important;
            text-decoration: none !important;
            padding: 10px 14px !important;
            border-radius: 3px !important;
            font-family: 'Inter', sans-serif;
            font-size: 12px !important;
            font-weight: 500;
            letter-spacing: .16em;
            text-transform: uppercase;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            white-space: nowrap;
            transition: background .15s ease, color .15s ease;
        }
        .login-slot a:hover,
        .login-slot button:hover,
        .login-slot .nav-link:hover {
            background: rgba(212,185,120,.12) !important;
            color: #fbf9f4 !important;
        }

        /* ================= MAIN ================= */
        main.site-main {
            max-width: 1400px;
            margin: 0 auto;
            padding: 32px 22px 60px;
            background: transparent;
        }

        /* ================= FOOTER — softer horizon ================= */
        .site-footer {
            position: relative;
            background:
                radial-gradient(ellipse at 18% 20%, rgba(168,139,74,.10) 0%, transparent 55%),
                radial-gradient(ellipse at 88% 80%, rgba(76,29,149,.14) 0%, transparent 55%),
                linear-gradient(120deg, var(--horizon-1) 0%, var(--horizon-2) 50%, var(--horizon-1) 100%);
            color: rgba(251,249,244,.80);
            margin-top: 80px;
            padding: 52px 22px 26px;
            overflow: hidden;
        }

        .site-footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 70px;
            background-image:
                url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1600' height='70' viewBox='0 0 1600 70' preserveAspectRatio='none'><path d='M0 60 L120 40 L220 52 L340 22 L460 46 L560 34 L680 8 L820 44 L940 26 L1060 46 L1180 30 L1300 52 L1420 34 L1540 48 L1600 40 L1600 70 L0 70 Z' fill='%234c1d95' fill-opacity='0.10'/><path d='M0 66 L160 50 L280 62 L400 38 L520 58 L640 46 L760 24 L880 54 L1000 40 L1120 58 L1240 46 L1360 62 L1480 48 L1600 58 L1600 70 L0 70 Z' fill='%23a88b4a' fill-opacity='0.08'/></svg>");
            background-position: top center;
            background-size: 100% 70px;
            background-repeat: no-repeat;
            pointer-events: none;
        }

        .site-footer::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                repeating-linear-gradient(90deg,
                    rgba(251,249,244,.015) 0px,
                    rgba(251,249,244,.015) 1px,
                    transparent 1px,
                    transparent 3px);
            pointer-events: none;
        }

        .footer-inner {
            position: relative;
            z-index: 1;
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr 1fr;
            gap: 40px;
        }
        .footer-brand {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 28px;
            font-weight: 600;
            color: #fbf9f4;
            margin: 0 0 12px;
            letter-spacing: -.01em;
        }
        .footer-brand em {
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-style: italic;
            font-weight: 500;
            color: var(--brass-light);
        }
        .footer-inner p {
            font-size: 14px;
            line-height: 1.7;
            margin: 0;
            color: rgba(251,249,244,.74);
            font-weight: 300;
        }

        .footer-col h4 {
            color: var(--brass-light);
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            letter-spacing: .38em;
            text-transform: uppercase;
            margin: 0 0 18px;
            font-weight: 600;
            position: relative;
            padding-bottom: 10px;
        }
        .footer-col h4::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 32px;
            height: 1px;
            background: linear-gradient(90deg, var(--brass), transparent);
        }
        .footer-col a {
            display: block;
            color: rgba(251,249,244,.70);
            text-decoration: none;
            padding: 7px 0;
            font-size: 14px;
            transition: color .15s ease, padding-left .2s ease;
        }
        .footer-col a:hover {
            color: var(--brass-light);
            padding-left: 4px;
        }

        .footer-bottom {
            position: relative;
            z-index: 1;
            max-width: 1400px;
            margin: 44px auto 0;
            padding-top: 24px;
            border-top: 1px solid rgba(212,185,120,.20);
            display: flex;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: rgba(251,249,244,.55);
            font-weight: 500;
        }

        /* ================= RESPONSIVE ================= */
        @@media (max-width: 992px) {
            .footer-inner { grid-template-columns: 1fr 1fr; }
        }

        @@media (max-width: 820px) {
            .site-nav {
                padding: 10px 16px;
                gap: 10px;
            }

            .nav-toggle {
                display: inline-flex;
                margin-left: auto;
                order: 2;
            }

            .cart-link {
                order: 3;
                margin-left: 0;
                padding: 8px 12px;
                font-size: 10px;
            }

            .login-slot {
                order: 3;
            }

            .nav-menu {
                order: 4;
                display: none;
                flex-direction: column;
                align-items: stretch;
                width: 100%;
                padding: 12px 0 16px;
                gap: 2px;
                border-top: 1px solid rgba(212,185,120,.22);
                margin-top: 8px;
            }
            .nav-menu.open { display: flex; }

            .nav-menu a,
            .nav-menu button.nav-trigger {
                width: 100%;
                padding: 12px 14px;
                font-size: 12px;
                color: rgba(251,249,244,.84);
            }

            .submenu {
                position: static;
                opacity: 1;
                visibility: visible;
                transform: none;
                box-shadow: none;
                border: none;
                background: rgba(212,185,120,.06);
                padding: 4px;
                margin-top: 4px;
                display: none;
                border-radius: 2px;
            }
            .has-menu.open .submenu { display: block; }
            .submenu a { color: rgba(251,249,244,.84) !important; }
            .submenu a:hover { background: rgba(212,185,120,.12); color: var(--brass-light) !important; }
            .submenu a i { color: var(--brass-light); }

            .footer-inner { grid-template-columns: 1fr; }
            main.site-main { padding: 22px 16px 40px; }
        }
    </style>

    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- ================= HEADER ================= -->
    <header class="site-header">
        <nav class="site-nav" aria-label="Primary">

            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="mark" aria-hidden="true"><i class="fa-solid fa-book-open"></i></span>
                <span>Book<em> Store</em></span>
            </a>

            <button class="nav-toggle" id="navToggle" type="button"
                    aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>

            <ul class="nav-menu" id="navMenu">
                <li>
                    <a asp-area="" asp-controller="Home" asp-action="Index"
                       class="@Active("Home")">
                        Home
                    </a>
                </li>

                @* ---------- Customer: My Orders ---------- *@
                @if (isAuthenticated && !isStaff)
                {
                    <li>
                        <a asp-area="Customer" asp-controller="Order" asp-action="Index"
                           class="@Active("Order", null, "Customer")">
                            My Orders
                        </a>
                    </li>
                }

                @if (isEmployee || isAdmin)
                {
                    <li class="has-menu" data-menu>
                        <button type="button" class="nav-trigger"
                                aria-haspopup="true" aria-expanded="false">
                            Content <i class="fa-solid fa-chevron-down caret" aria-hidden="true"></i>
                        </button>
                        <ul class="submenu">
                            <li><a asp-area="Admin" asp-controller="Category" asp-action="Index"><i class="fa-solid fa-tag"></i>Category</a></li>
                            <li><a asp-area="Admin" asp-controller="CoverTypes" asp-action="Index"><i class="fa-solid fa-book"></i>Cover Types</a></li>
                            <li class="divider" role="separator"></li>
                            <li><a asp-area="Admin" asp-controller="Product" asp-action="Index"><i class="fa-solid fa-box"></i>Product</a></li>
                        </ul>
                    </li>
                }

                @if (isAdmin)
                {
                    <li class="has-menu" data-menu>
                        <button type="button" class="nav-trigger"
                                aria-haspopup="true" aria-expanded="false">
                            Manage <i class="fa-solid fa-chevron-down caret" aria-hidden="true"></i>
                        </button>
                        <ul class="submenu">
                            <li><a asp-area="Admin" asp-controller="Company" asp-action="Index"><i class="fa-solid fa-building"></i>Company</a></li>
                            <li><a asp-area="Admin" asp-controller="User" asp-action="Index"><i class="fa-solid fa-users"></i>Users</a></li>
                        </ul>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="Order" asp-action="Index"
                           class="@Active("Order", null, "Admin")">
                            Orders
                        </a>
                    </li>
                }
            </ul>

            <a class="cart-link" asp-area="Customer" asp-controller="Cart" asp-action="Index"
               aria-label="Cart, @cartCount items">
                <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                <span class="count">@cartCount</span>
            </a>

            <div class="login-slot">
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <!-- ================= MAIN ================= -->
    <main id="main" class="site-main" role="main">
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="site-footer">
        <div class="footer-inner">
            <div>
                <h3 class="footer-brand">Book <em>Store</em></h3>
                <p>Fine books, carefully chosen. Independent since MMXXV — for readers who linger.</p>
            </div>
            <div class="footer-col">
                <h4>Shop</h4>
                <a asp-area="" asp-controller="Home" asp-action="Index">Catalogue</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-sortOrder="bestseller">Bestsellers</a>
                <a asp-area="Customer" asp-controller="Cart" asp-action="Index">Your Cart</a>
            </div>
            <div class="footer-col">
                <h4>Account</h4>
                @if (isAuthenticated)
                {
                    <a asp-area="Customer" asp-controller="Order" asp-action="Index">My Orders</a>
                }
                <a asp-area="Identity" asp-page="/Account/Manage/Index">Profile</a>
                <a asp-area="Identity" asp-page="/Account/Manage/Email">Email</a>
                <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword">Password</a>
            </div>
            <div class="footer-col">
                <h4>About</h4>
                <a href="#">Our Story</a>
                <a href="#">Shipping</a>
                <a href="#">Return</a>
            </div>
        </div>
        <div class="footer-bottom">
            <span>&copy; @DateTime.UtcNow.Year Book Store · All rights reserved</span>
            <span>Made by M🔺Y🔺N K</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js"
            integrity="sha512-AA1Bzp5Q0K1KanKKmvN/4d3IRKVlv9PYgwFPvm32nPO6QS8yH1HO7LbgB1pgiOxPtfeg5zEn2ba64MUcqJx6CA=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://kit.fontawesome.com/e19c476714.js" crossorigin="anonymous"></script>

    <script>
        (function () {
            'use strict';

            var toggle = document.getElementById('navToggle');
            var menu = document.getElementById('navMenu');
            if (toggle && menu) {
                toggle.addEventListener('click', function () {
                    var open = menu.classList.toggle('open');
                    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
            }

            document.querySelectorAll('[data-menu]').forEach(function (li) {
                var trigger = li.querySelector('.nav-trigger');
                if (!trigger) return;

                trigger.addEventListener('click', function (e) {
                    e.preventDefault();
                    var open = li.classList.toggle('open');
                    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
            });

            document.addEventListener('click', function (e) {
                document.querySelectorAll('[data-menu].open').forEach(function (li) {
                    if (!li.contains(e.target)) {
                        li.classList.remove('open');
                        var t = li.querySelector('.nav-trigger');
                        if (t) t.setAttribute('aria-expanded', 'false');
                    }
                });
            });

            document.addEventListener('keydown', function (e) {
                if (e.key !== 'Escape') return;
                document.querySelectorAll('[data-menu].open').forEach(function (li) {
                    li.classList.remove('open');
                    var t = li.querySelector('.nav-trigger');
                    if (t) t.setAttribute('aria-expanded', 'false');
                });
                if (menu) menu.classList.remove('open');
                if (toggle) toggle.setAttribute('aria-expanded', 'false');
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>